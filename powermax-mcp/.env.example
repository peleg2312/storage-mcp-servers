# ---- MCP access token(s) - clients send "Authorization: Bearer <token>" ----
# generate with: openssl rand -hex 32   (comma-separate several to rotate)
MCP_AUTH_TOKENS=replace-with-output-of-openssl-rand-hex-32

# ---- Unisphere servers: add _3_, _4_ ... for more ----
UNISPHERE_1_NAME=dc1
UNISPHERE_1_HOST=unisphere-dc1.example.local
UNISPHERE_1_USERNAME=mcp-monitor
UNISPHERE_1_PASSWORD=changeme
# optional per server: _PORT (8443), _VERIFY_SSL (false|true|/path/ca.pem), _API_VERSION (auto), _TIMEOUT (120)

UNISPHERE_2_NAME=dc2
UNISPHERE_2_HOST=unisphere-dc2.example.local
UNISPHERE_2_USERNAME=mcp-monitor
UNISPHERE_2_PASSWORD=changeme

# optional: array used when a tool is called without array_id
POWERMAX_DEFAULT_ARRAY=
LOG_LEVEL=INFO

# ---- MCP access token(s) - clients send "Authorization: Bearer <token>" ----
# generate with: openssl rand -hex 32   (comma-separate several to rotate)
MCP_AUTH_TOKENS=replace-with-output-of-openssl-rand-hex-32

# ---- PowerFlex Gateway (3.x) or PowerFlex Manager (4.x / 5.x): add _3_, _4_ ... for more ----
# the API kind is detected at sign-in; use a read-only (Monitor) account
POWERFLEX_1_NAME=dc1
POWERFLEX_1_HOST=pfmp-dc1.example.local
POWERFLEX_1_USERNAME=mcp-monitor
POWERFLEX_1_PASSWORD=changeme
# optional per gateway: _PORT (443), _VERIFY_SSL (false|true|/path/ca.pem), _TIMEOUT (60)

POWERFLEX_2_NAME=dc2
POWERFLEX_2_HOST=pfgw-dc2.example.local
POWERFLEX_2_USERNAME=mcp-monitor
POWERFLEX_2_PASSWORD=changeme

# optional: system (id or name) used when a tool is called without system_id
POWERFLEX_DEFAULT_SYSTEM=
LOG_LEVEL=INFO

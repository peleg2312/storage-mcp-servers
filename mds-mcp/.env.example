# ---- MCP access token(s) - clients send "Authorization: Bearer <token>" ----
# generate with: openssl rand -hex 32   (comma-separate several to rotate)
MCP_AUTH_TOKENS=replace-with-output-of-openssl-rand-hex-32

# ---- MDS switches: add _3_, _4_ ... for more ----
# use a network-operator (read-only) account, not admin
MDS_1_NAME=mds-fab-a
MDS_1_HOST=mds-fab-a.example.local
MDS_1_USERNAME=mcp-ro
MDS_1_PASSWORD=changeme
# optional per switch: _PORT (8443), _VERIFY_SSL (false)

MDS_2_NAME=mds-fab-b
MDS_2_HOST=mds-fab-b.example.local
MDS_2_USERNAME=mcp-ro
MDS_2_PASSWORD=changeme

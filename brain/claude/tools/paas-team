def ext_links(tdir, t):
    """a brain laid out as a team: its knowledge files linked into ~/.claude/brain as a team's are (notes.md, notes/,
    runbooks/ ...), so Claude, the Brain tab and the hooks find them where they always are. Unlike a team's first use,
    the person's own files are never merged into it (nothing is written into its repository): they are kept beside as
    <name>.pre-team and come back when the brain is left. Returns the names linked."""
    if not team_layout(tdir, t):
        return []
    out = []
    real = os.path.realpath(tdir)
    for name in LINKS:
        target = os.path.join(tdir, "knowledge", name)
        if not os.path.exists(target) or os.path.islink(target) or not os.path.realpath(target).startswith(real + os.sep):
            continue
        p = os.path.join(BRAIN, name)
        if os.path.islink(p):
            if os.readlink(p) == target:
                out.append(name)
                continue
            os.remove(p)                                      # another team's or brain's link
        elif is_junction(p):
            os.rmdir(p)
        elif os.path.exists(p):
            if same(p, target):
                out.append(name)
                continue
            park(p)                                           # the person's own: kept aside, given back when leaving
        make_link(target, p)
        out.append(name)
    return out


def ext_rules(tdir):
    """an external brain's rules/main.md, storage.md, coding.md (what a team built here has in its rules/) linked into
    ~/.claude/brain in place of the previous team's, main.md through the import line in ~/.claude/CLAUDE.md, exactly as a
    team's are; a rule it does not have goes back to the VM's default when it was another brain's. Nothing is written
    into the brain's repository. Returns the rules/<name> it linked (the persona imports the rest of its rule files)."""
    linked = []
    real = os.path.realpath(tdir)
    for name, tpl in RULES:
        if name == "persona.md":                              # the persona is written here: it names the brain, imports its own
            continue
        own, p = os.path.join(tdir, "rules", name), os.path.join(BRAIN, name)
        if os.path.isfile(own) and not os.path.islink(own) and os.path.realpath(own).startswith(real + os.sep):
            link_rule(name, own)
            linked.append("rules/" + name)
            if name == "main.md":
                ensure_import()
        elif os.path.islink(p) and os.path.realpath(p).startswith(os.path.realpath(TEAMS) + os.sep):
            d = os.path.join(VM_DEFAULTS, tpl)                # another team's or brain's rule: the VM's own again
            if os.path.isfile(d):
                os.remove(p)
                shutil.copy(d, p)
    return linked


def load_docs(team, force=False):
    """root: an external brain's docs folder (brain.json "docs", or docs/upstream) as the team library of the same name:
    one product per sub-folder (<library>/docs/<team>/<product>, mirrored: a document deleted in git leaves the library
    too), then one incremental build. Skipped when the docs folder is the same commit tree as last time (--force builds
    anyway). The VM's teams folder copy is used first (what the docs service serves), else the person's clone."""
    tdir = next((d for d in (os.path.join(SOURCES, team), team_dir(team))
                 if os.path.isdir(d) and not paas_team_repo(d) and (external(d) or find_plugin(d, team))), "")
    if not tdir:
        die(f"no brain {team!r} with its own docs folder here")
    rec = external(tdir) or {"dir": find_plugin(tdir, team)[2], "env": {}}      # a VM copy root cloned: detected the same way
    lay = ext_layout(tdir, rec, team)
    if not lay["docs"] or not lay["library"] or not NAME.match(lay["library"]):
        print(f"{team}: no docs folder (brain.json \"docs\", or docs/upstream): no library to build")
        return 0
    lib = next((p for p in ("/opt/paas/bin/paas-library", os.path.join(HOME, "tools", "paas-library"),
                            os.path.join(os.path.dirname(os.path.realpath(__file__)), "paas-library")) if os.path.isfile(p)), "")
    if not lib:
        die("paas-library is not installed here")
    r = subprocess.run([sys.executable, lib, "path", lay["library"]], capture_output=True, text=True, timeout=60)
    ldir = r.stdout.strip()
    if r.returncode or not ldir:
        die(f"paas-library path {lay['library']}: {(r.stdout + r.stderr).strip()[-200:]}")
    owner = os.path.join(ldir, ".brain")                     # whose library this is: never another library's documents mixed in
    who = read(owner).strip()
    has_docs = os.path.isdir(os.path.join(ldir, "docs")) and any(os.scandir(os.path.join(ldir, "docs")))
    if (who and who != team) or (not who and has_docs):
        print(f"library {lay['library']}: already holds other documents ({who or 'not from a brain'}); "
              f"{team}'s docs are not mixed in: name another library in its brain.json (\"library\")")
        return 1
    if not who:
        os.makedirs(ldir, exist_ok=True)
        write(owner, team + "\n")
        os.chmod(owner, 0o644)
    rc, tree = git(tdir, "rev-parse", "HEAD:" + lay["docs"], timeout=10)
    if lay.get("docs_index"):                                 # and its index: both must be the same commit's
        rc2, itree = git(tdir, "rev-parse", "HEAD:" + lay["docs_index"], timeout=10)
        rc, tree = (rc or rc2), f"{tree}+{itree}"
    mark = os.path.join(ldir, ".source-" + team)
    if not force and rc == 0 and tree and os.path.isfile(os.path.join(ldir, "docs.db")) and read(mark).strip() == tree:
        print(f"library {lay['library']}: {team}'s docs unchanged ({tree[:10]}), nothing to build")
        return 0
    src = os.path.join(tdir, lay["docs"])
    if lay.get("docs_index"):                                 # built ahead by the brain: copied as it is, nothing re-indexed
        dst = os.path.join(ldir, "docs")
        shutil.rmtree(dst, ignore_errors=True)
        shutil.copytree(src, dst, symlinks=False, ignore=shutil.ignore_patterns(".*"))
        shutil.copy2(os.path.join(tdir, lay["docs_index"]), os.path.join(ldir, "docs.db.new"))
        os.replace(os.path.join(ldir, "docs.db.new"), os.path.join(ldir, "docs.db"))
        for dp, dirs, fs in os.walk(ldir):                    # read by every account and the docs service
            os.chmod(dp, 0o755)
            for f in fs:
                os.chmod(os.path.join(dp, f), 0o644)
        n = sum(len(fs) for _, _, fs in os.walk(dst))
        print(f"library {lay['library']}: {n} documents and the index {team} built ({lay['docs_index']}), copied as they are")
        if rc == 0 and tree:
            write(mark, tree + "\n")
            os.chmod(mark, 0o644)
        return 0
    subs = sorted(d for d in os.listdir(src) if os.path.isdir(os.path.join(src, d)) and not d.startswith(".") and not os.path.islink(os.path.join(src, d)))
    dst = os.path.join(ldir, "docs", re.sub(r"[^a-z0-9_.-]+", "-", team.lower()))
    shutil.rmtree(dst, ignore_errors=True)                    # mirrored: the docs in git are the library's
    n = 0
    for d in subs or ["."]:
        prod = re.sub(r"[^a-z0-9_.-]+", "-", (d if d != "." else team).lower()).strip("-.") or "docs"
        base = os.path.join(src, d)
        for dp, dirs, fs in os.walk(base):
            dirs[:] = [x for x in dirs if not x.startswith(".") and not os.path.islink(os.path.join(dp, x))]
            for f in fs:
                fp = os.path.join(dp, f)
                if f.startswith(".") or os.path.islink(fp) or not os.path.isfile(fp):
                    continue
                to = os.path.join(dst, prod, os.path.relpath(fp, base))
                os.makedirs(os.path.dirname(to), exist_ok=True)
                shutil.copy2(fp, to)                           # mtimes kept: the build reads only what changed
                n += 1
    print(f"library {lay['library']}: {n} documents from {team}'s {lay['docs']} ({len(subs) or 1} products)")
    if not n:
        return 0
    r = subprocess.run([sys.executable, lib, "build", lay["library"]], capture_output=True, text=True, timeout=7200)
    print((r.stdout + r.stderr).strip()[-400:])
    if r.returncode == 0 and rc == 0 and tree:
        write(mark, tree + "\n")
        os.chmod(mark, 0o644)
    return r.returncode


def brain_layout(tdir, name):

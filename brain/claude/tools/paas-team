def edit(team, change):
    """apply a JSON change to the team's repository (local clone; added first when needed), commit, push, re-apply"""
    if external(team_dir(team)):
        die(f"{team} is changed in its own repository (its settings: paas-team env {team} KEY=VALUE)")
    add(team, None, quiet=True)
    tdir = team_dir(team)
    if remote_of(tdir):                                       # edit on top of what the team has now
        git(tdir, "add", "-A", timeout=30)
        git(tdir, "commit", "-q", "-m", f"team {team}: before an edit", timeout=30)
        rc, out = git(tdir, "pull", "--rebase", "-q", timeout=60)
        if rc and git(tdir, "diff", "--name-only", "--diff-filter=U", timeout=5)[1]:
            git(tdir, "rebase", "--abort", timeout=10)
            die("the team repository changed in a way that clashes with this clone; run paas-team sync, resolve the "
                "conflict it names, then edit again")
        elif rc:
            git(tdir, "rebase", "--abort", timeout=10)        # offline, or the remote did not answer: edit locally, push later
    plug = plugin_dir(tdir)
    b = os.path.join(plug, "brain")
    pj = os.path.join(plug, "team.json")
    t = jload(pj)
    old_root = jload(os.path.join(tdir, "team.json"))          # an older repository's copy: its remote moves into the plugin's
    if old_root.get("remote") and not t.get("remote"):
        t["remote"] = old_root["remote"]
    for k in ("title", "description"):
        if isinstance(change.get(k), str):
            t[k] = change[k].strip()
    for k, f in (("persona", "persona.md"), ("rules", "storage.md"), ("main", "main.md"), ("coding", "coding.md"),
                 ("environment", "environment.md")):
        if isinstance(change.get(k), str) and change[k].strip():
            own = os.path.join(tdir, "rules", f)           # the team's rules/ when the repository has it, else the plugin's copy
            tpl = os.path.join(b, dict(RULES).get(f, f))   # (main.md started from the plugin's CLAUDE.md)
            write(own if f != "environment.md" and os.path.isfile(own) else tpl, change[k].rstrip() + "\n")
    for kind in ("skills", "agents"):
        if not isinstance(change.get(kind), list):
            continue
        want = [str(n) for n in dict.fromkeys(change[kind]) if NAME.match(str(n).lower())]
        have = set(t.get(kind, []))
        cand = {c["name"]: c["path"] for c in candidates(kind)}
        ext = "" if kind == "skills" else ".md"
        for n in have - set(want):
            p = os.path.join(plug, kind, n + ext)
            shutil.rmtree(p, ignore_errors=True) if kind == "skills" else (os.path.isfile(p) and os.remove(p))
        for n in want:
            dst = os.path.join(plug, kind, n + ext)
            if os.path.exists(dst):
                continue
            src = cand.get(n)
            if not src:
                die(f"{kind[:-1]} {n!r} is nowhere to be found (your ~/.claude, the marketplace, another team)")
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copytree(src, dst, ignore=shutil.ignore_patterns(".user-skill", "__pycache__")) if kind == "skills" else shutil.copy(src, dst)
        t[kind] = want
    servers = load_servers(plug, tdir)
    for n in change.get("remove_mcp") or []:
        servers.pop(str(n), None)
    for n, c in (change.get("mcp_servers") or {}).items():
        if not NAME.match(str(n).lower()) or not isinstance(c, dict):
            continue
        cur = dict(servers.get(n) or {})
        if c.get("command"):
            cur = {"type": "stdio", "command": str(c["command"]), "args": [str(a) for a in c.get("args") or []]}
        elif c.get("url"):
            cur = {"type": c.get("type") or "http", "url": str(c["url"]).strip(), **({"headers": cur["headers"]} if cur.get("headers") else {})}
        if "token" in c:                                      # a string sets it, null / empty removes it, absent keeps it
            tok = str(c["token"] or "").strip()
            was = str((servers.get(n) or {}).get("headers", {}).get("Authorization", ""))
            bare = bool(was) and not was.startswith("Bearer ")   # the catalog shape (or the admin) chose a bare secret: keep it so
            if tok:
                cur["headers"] = {"Authorization": tok if bare or tok.startswith("Bearer ") else "Bearer " + tok}
            else:
                cur.pop("headers", None)
        servers[n] = cur
    removed = {str(n) for n in change.get("remove_mcp") or []}
    t["mcp"] = ["docs-local"] + [n for n in dict.fromkeys(list(t.get("mcp", [])) + list(servers)) if n != "docs-local" and n not in removed]
    save_servers(plug, servers, t)                           # the plugin connects the filled-in servers for every member
    write(pj, json.dumps(t, indent=2, sort_keys=True) + "\n")
    bump_version(plug)                                       # a new version string: plugin-mode members get the new copy
    for old in ("mcp.json", "team.json"):                    # one copy: an older repository's root files are now in the plugin
        if os.path.isfile(os.path.join(tdir, old)):
            os.remove(os.path.join(tdir, old))
    git(tdir, "add", "-A", timeout=30)
    git(tdir, "commit", "-q", "-m", f"brain tab: team {team} edited", timeout=30)
    pushed = ""
    if remote_of(tdir):
        rc, out = git(tdir, "push", "-q", timeout=60)
        pushed = "pushed to the team repository" if rc == 0 else "not pushed (the next sync retries): " + (out.splitlines()[-1][:120] if out else "?")
    else:
        pushed = "no remote: the change stays on this machine"
    if active() == team:
        apply(team, say=False)
    print(f"edited team {team}: {len(t.get('skills', []))} skills, {len(t.get('agents', []))} agents, MCP {', '.join(t['mcp'])}; {pushed}"
          + ("; re-applied, a new Claude session uses it" if active() == team else ""))


def status():
    d = listing()
    act = d["active"]
    if not act:
        print("team: none active" + (f" ({len(d['teams'])} available: " + ", ".join(x["name"] for x in d["teams"]) + ")" if d["teams"] else ""))
        return
    t = next(x for x in d["teams"] if x["name"] == act)
    print(f"team: {act} ({t['title']}), version {t['version']}, {t['skills']} skills, {t['agents']} agents")
    tdir = team_dir(act)
    if t["remote"]:
        rc, out = git(tdir, "rev-list", "--left-right", "--count", "HEAD...@{upstream}", timeout=5)
        a, b = (out.split() + ["?", "?"])[:2] if rc == 0 else ("?", "?")
        print(f"remote: {t['remote']} ({'in sync' if (a, b) == ('0', '0') else a + ' ahead, ' + b + ' behind'})")
    else:
        print("remote: none (paas-team remote %s <url>)" % act)
    if needs_refresh():
        print("the team repository changed since it was applied: paas-team refresh")
    others = [x["name"] for x in d["teams"] if x["name"] != act]
    if others:
        print("other teams: " + ", ".join(others) + "   (paas-team use <team>)")


def main(a):
    cmd = a[0] if a else "status"
    if cmd == "status":
        status()
    elif cmd == "list":
        d = listing()
        if "--json" in a:
            print(json.dumps(d))
        else:
            for t in d["teams"]:
                print("%s %-8s %-28s %s%s%s" % ("*" if t["active"] else " ", t["name"], t["title"][:28],
                                               "local" if t["local"] else "available", f", {t['version']}" if t["version"] else "",
                                               f", plugin {t.get('plugin')}" if t.get("external") else ""))
            if not d["teams"]:
                print("no teams (paas-team add <team> <git url>)")
    elif cmd == "add" and len(a) >= 2:
        add(a[1], a[2] if len(a) > 2 else None)
        print(f"team {a[1]} added ({team_dir(a[1])}); paas-team use {a[1]} switches to it")
    elif cmd == "use" and len(a) >= 2 and a[1] in ("none", "off"):
        off()
    elif cmd == "use" and len(a) >= 2:
        use(a[1], a[2] if len(a) > 2 else None)
    elif cmd == "show" and len(a) >= 2:
        d = show(a[1])
        if "--json" in a:
            print(json.dumps(d))
        else:
            print(f"{d['name']}: {d['title']} ({d['version']}); skills {len(d['skills'])}, agents {len(d['agents'])}, MCP {', '.join(d['mcp'])}")
            for n, c in d["mcp_servers"].items():
                print(f"  {n}: {c['url'] or c['command']} {'ready' if c['configured'] else 'HOST / TOKEN not filled in'}")
    elif cmd == "learn" and len(a) >= 2:
        set_learn(a[1], a[2] if len(a) > 2 else "")
    elif cmd == "relayout" and len(a) >= 2:                     # the learning hook: root or the brain changed brain.json
        if external(team_dir(a[1])):
            refresh_layout(team_dir(a[1]))
    elif cmd == "layout" and len(a) >= 3:                       # the docs service: an external brain's folders, as detected here
        print(json.dumps(brain_layout(a[1], a[2])))
    elif cmd == "docs" and len(a) >= 2 and a[1] == "--all":
        sys.exit(docs_all(pull="--no-pull" not in a))
    elif cmd == "docs" and len(a) >= 2:
        sys.exit(load_docs(a[1], force="--force" in a))
    elif cmd == "env" and len(a) >= 2:
        names = set_env(a[1], a[2:])
        print(f"brain {a[1]}: settings {', '.join(names) or 'none'}" + (" (applied: start a new chat)" if active() == a[1] and a[2:] else ""))
    elif cmd == "edit" and len(a) >= 2:
        try:
            change = json.load(sys.stdin)
        except ValueError:
            die("edit: JSON expected on stdin")
        edit(a[1], change)
    elif cmd == "bump" and len(a) >= 2:
        plug = plugin_dir(team_dir(a[1]))
        plug or die(f"team {a[1]} is not added")
        print(bump_version(plug))
    elif cmd == "bootstrap" and len(a) >= 3:
        bootstrap(a[1], a[2])
    elif cmd == "refresh":
        refresh()
    elif cmd == "relink":
        relink(background="--background" in a)
    elif cmd == "plugin-update":
        sys.exit(plugin_update())
    elif cmd == "link-files":
        for n in link_files():
            print(f"re-linked {n}")
    elif cmd == "sync":
        sys.exit(sync())
    elif cmd == "remote" and len(a) >= 3:
        set_remote(a[1], a[2])
    elif cmd == "off":
        off()
    elif cmd == "needs-refresh":
        sys.exit(0 if needs_refresh() else 1)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])

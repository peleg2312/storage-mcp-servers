def clone_local(source, dest):
    """git clone of a folder on this machine, also when it belongs to another account (root's copies in the VM's teams
    folder: git refuses "dubious ownership"). The exception for that one folder is given the way git honours it, in a
    global config for this command only that includes the person's own (their credential helper, identity)."""
    import tempfile
    fd, cfg = tempfile.mkstemp(prefix="paas-team-git-", suffix=".cfg")
    try:
        with os.fdopen(fd, "w") as f:
            for inc in (os.environ.get("GIT_CONFIG_GLOBAL") or os.path.expanduser("~/.gitconfig"),
                        os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "git", "config")):
                if os.path.isfile(inc):
                    f.write(f"[include]\n\tpath = {inc}\n")
            f.write(f"[safe]\n\tdirectory = {source}\n\tdirectory = {os.path.join(source, '.git')}\n")
        r = subprocess.run(["git", "clone", "-q", "--", source, dest], capture_output=True, text=True, timeout=120,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_CONFIG_GLOBAL=cfg))
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 124, str(e)
    finally:
        os.remove(cfg)


def add(team, source=None, quiet=False):
    if not NAME.match(team or ""):
        die("team name: lower-case letters, digits, - and _")
    dest = team_dir(team)
    if plugin_dir(dest) or external(dest):
        return dest
    if os.path.isdir(os.path.join(dest, ".git")) and mark_external(dest, team):   # another brain cloned there by hand
        return dest
    if os.path.exists(dest):
        if os.path.isdir(os.path.join(dest, "knowledge")) or (os.path.isdir(os.path.join(dest, ".git")) and
                                                               git(dest, "rev-parse", "--verify", "-q", "HEAD", timeout=5)[0] == 0):
            die(f"{dest} exists but holds no team plugin; remove it first")
        shutil.rmtree(dest, ignore_errors=True)                    # an interrupted clone: start again
    os.makedirs(TEAMS, exist_ok=True)
    tmp = dest + ".tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    src_dir = os.path.join(SOURCES, team)
    if not source:
        if plugin_dir(src_dir):
            source = info(src_dir).get("remote") or config_origin(src_dir) or src_dir     # GitLab first: members push there
        elif os.path.isdir(os.path.join(src_dir, ".git")) and find_plugin(src_dir, team):   # an external brain root put here
            source = config_origin(src_dir) or src_dir                 # root's copy: git refuses another owner's repository
        else:
            die(f"no team {team!r}: give its git url or directory (paas-team add {team} <source>)")
    bare = os.path.isdir(source) and os.path.isfile(os.path.join(source, "HEAD")) and os.path.isdir(os.path.join(source, "objects"))
    url = source if "://" in source or (":" in source and not os.path.exists(source)) or bare else ""   # a bare repository: cloned like a url
    if url:
        if not quiet:
            print(f"cloning team {team} from {url} ...")
        rc, out = git(TEAMS, "clone", "-q", "--", url, tmp, timeout=300)
        if rc == 0 and not plugin_dir(tmp):                  # not a paas team: another Claude Code brain, kept as it is
            if not mark_external(tmp, team):
                shutil.rmtree(tmp, ignore_errors=True)
                die(f"{url} holds no brain: no paas-brain-<team> plugin, no Claude Code plugin, no skills/ or agents/")
        if rc and (plugin_dir(src_dir) or find_plugin(src_dir, team)):   # the remote is not reachable: the VM's copy, remote kept
            print(f"note: clone from {url} failed ({out.splitlines()[-1][:120] if out else 'no answer'}); using {src_dir}, "
                  "the remote is set for later syncs")
            shutil.rmtree(tmp, ignore_errors=True)
            source, url_later = src_dir, url
        elif rc:
            shutil.rmtree(tmp, ignore_errors=True)
            die(f"clone failed: {out[-300:]}")
        else:
            os.rename(tmp, dest)
            return dest
    else:
        url_later = info(source).get("remote") or "" if os.path.isdir(source) and plugin_dir(source) else ""   # a copy of the team repository: GitLab stays origin
        if os.path.isdir(source) and not plugin_dir(source):
            url_later = config_origin(source)
    source = os.path.abspath(source)
    if not plugin_dir(source) and not find_plugin(source, team):
        die(f"{source} is not a team repository (no paas-brain-<team>/team.json) and holds no other Claude Code brain")
    if os.path.isdir(os.path.join(source, ".git")):
        rc, out = clone_local(source, tmp)
        if rc:
            shutil.rmtree(tmp, ignore_errors=True)
            die(f"clone of {source} failed: {out[-300:]}")
        if url_later:
            git(tmp, "remote", "set-url", "origin", url_later, timeout=5)
    else:
        shutil.copytree(source, tmp, ignore=shutil.ignore_patterns("__pycache__", "*.pyc", "._*"))
        git(tmp, "init", "-q", "-b", "main", timeout=10)
        git(tmp, "add", "-A", timeout=30)
        git(tmp, "commit", "-q", "-m", f"team {team}: added", timeout=30)
        if url_later:
            git(tmp, "remote", "add", "origin", url_later, timeout=5)
    if not plugin_dir(tmp) and not mark_external(tmp, team):
        shutil.rmtree(tmp, ignore_errors=True)
        die(f"{source} holds no brain")
    os.rename(tmp, dest)
    return dest



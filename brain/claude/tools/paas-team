        die(f"{team} takes no settings here (paas-team edit changes a team's MCP servers)")
    env = dict(e.get("env") or {})
    for p in pairs:
        if "=" not in p or not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", p.split("=", 1)[0]):
            die(f"env: KEY=VALUE expected, not {p!r}")
        k, v = p.split("=", 1)
        if v == "":
            env.pop(k, None)
        else:
            env[k] = v
    e["env"] = env
    e.update(ext_layout(tdir, e, team))                     # a setting added by hand is listed too
    save_rec(tdir, e)
    if active() == team:
        apply_ext_env(team)
    return sorted(env)



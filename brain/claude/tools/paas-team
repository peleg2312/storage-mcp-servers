#!/usr/bin/env python3
"""Team profiles of the brain: which brain (rules, skills, agents, knowledge) this account works with, switched in
seconds. A team is a git repository published by brain/teams/publish.py: the plugin paas-brain-<team>/ plus
knowledge/ (notes/, runbooks/, captures/, incidents/, tool-map.md) and rules/ (main.md, persona.md, storage.md, coding.md: the team's own
rules, edited there and linked into ~/.claude/brain, never written by this tool). Each team the person added is a clone under
~/.claude/brain/teams/<team>; the active one is the Claude Code plugin paas-brain-<team> (enabled from that clone, the
same plugin everyone installs) and its knowledge is linked into the brain's usual paths, so every skill, hook and the
web UI keep reading ~/.claude/brain/notes.md, notes/, captures/, incidents/, tool-map.md, environment.md,
persona.md and storage.md as before. Needs the claude command for the plugin steps; without it the rules and the
knowledge are still switched and the plugin is registered at the next `paas-team use`.

  paas-team                        status: active team, local teams, sync state
  paas-team list [--json]          local teams and the ones a source offers
  paas-team add <team> [<source>]  clone the team repository (git url or directory); default source: the VM's
                                   /opt/paas/teams/<team> (its recorded remote when it has one)
  paas-team use <team>             switch to it (added first when needed); then start a new Claude session
  paas-team refresh                re-apply the active team's files (after its repository was updated)
  paas-team sync                   pull / push the active team's knowledge, refresh if its plugin changed
  paas-team remote <team> <url>    set (or change) the git remote of a local team
  paas-team off                    no team: the team's plugin is disabled (its skills, agents and MCP servers with it), the
                                   knowledge files become your own plain files; your own and marketplace skills stay (also: paas-team use none)
  paas-team show <team> [--json]   the team's definition: persona, rules, skills, agents, MCP servers, what could be added
  paas-team env <team> [KEY=VALUE ...] [KEY=]   settings an external brain's plugin reads (its server addresses,
                                   tokens): kept in its clone's .git, put into ~/.claude/settings.json "env" while it is
                                   active ({dir} = the clone); without pairs: the names set
  paas-team docs <team> [--force]  root: an external brain's docs folder (brain.json "docs", or docs/upstream) into a team
                                   library of the same name (paas-library, mirrored; skipped when unchanged), used by the
                                   Docs tab and docs-local while that brain is active
  paas-team learn <brain> [merge-request|push|off]   an external brain keeps what Claude learns in its own git:
                                   merge requests for its team to review, or pushed at once (root on the VM: for every
                                   member, beside its VM copy; anyone else: their own clone); without a mode: the state
  paas-team docs --all [--no-pull] root, multi-user VM: every external brain in /opt/paas/teams pulled (fast-forward) and its
                                   library built when its docs changed (install-shared.sh and the daily timer run it)
  paas-team edit <team>            change it from JSON on stdin (title, description, persona, rules (storage.md), main
                                   (the golden rules, main.md), coding, environment, skills,
                                   agents, mcp_servers {name: {url, type, token}}, remove_mcp): written into the team's
                                   plugin (filled-in servers into its .mcp.json, the others into team.json), committed, pushed,
                                   re-applied; the Brain tab's team editor uses it
External brains: `paas-team add <name> <git url>` also takes any other Claude Code brain kept as its owners publish it (a
repository with a plugin marketplace, a plugin folder, or plain skills/ and agents/): it is cloned as it is, marked in its
own .git (paas-external.json; a missing marketplace.json is written there as an untracked, git-excluded file), and `use`
installs and enables its plugin instead of a paas-brain one. Its repository is never written: no knowledge links, no
commits or pushes from the brain's hooks (it keeps its own workflow), `sync` only fast-forwards it. Its environment
variables come from `paas-team env`; a variable its scripts read for "where is my repository" (TEAM_BRAIN_DIR=~/..) is set
to the clone when it is added.
Environment: PAAS_TEAMS (source directory: /opt/paas/teams on a multi-user VM, else ~/.claude/brain/team-sources,
written by the installer), CLAUDE_HOME (default ~/.claude).
Standard library, Python 3.9. The only credentials it handles are the team's MCP tokens, which `edit` writes into the
team plugin's .mcp.json by the team's decision (see brain/teams/README.md); nothing else is ever written."""
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.environ.get("CLAUDE_HOME") or os.path.expanduser("~/.claude")
BRAIN = os.path.join(HOME, "brain")
TEAMS = os.path.join(BRAIN, "teams")
SOURCES = os.environ.get("PAAS_TEAMS") or ("/opt/paas/teams" if os.path.isdir("/opt/paas/teams")
                                            else os.path.join(BRAIN, "team-sources"))   # multi-user VM, else the installer's copies
STATE = os.path.join(TEAMS, ".installed.json")             # skills / agents the active team put into ~/.claude
NAME = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
LINKS = ("notes.md", "environment.md", "tool-map.md", "notes", "runbooks", "captures", "incidents")   # brain paths -> knowledge/
# brain paths -> the team repository's rules/ (owned and edited by the team, never written by this tool); the plugin's brain/
# file each one started from (publish.py creates rules/ from these once). A team repository published before rules/ existed
# gets the plugin's copies as before.
RULES = (("main.md", "CLAUDE.md"), ("persona.md", "persona.md"), ("storage.md", "storage.md"), ("coding.md", "coding.md"))
IMPORT = "@~/.claude/brain/main.md"
_IDENT = {}


def identity(repo):
    """Who commits: the person's own git identity when configured, else <login>@<host>, so the team repository's history
    says who wrote what (the push may authenticate as the team's GitLab token)."""
    if repo not in _IDENT:
        try:
            r = subprocess.run(["git", "-C", repo, "config", "--get-regexp", r"^user\.(name|email)$"], stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=5)
            have = {l.split()[0] for l in r.stdout.splitlines() if l.strip()}
        except Exception:
            have = set()
        import getpass                              # pwd / getuid do not exist on Windows
        import socket
        try:
            name = getpass.getuser()
        except Exception:
            name = os.environ.get("USER") or os.environ.get("USERNAME") or "brain"
        env = {}
        if "user.name" not in have:
            env.update(GIT_AUTHOR_NAME=name, GIT_COMMITTER_NAME=name)
        if "user.email" not in have:
            env.update(GIT_AUTHOR_EMAIL=f"{name}@{socket.gethostname()}", GIT_COMMITTER_EMAIL=f"{name}@{socket.gethostname()}")
        _IDENT[repo] = env
    return _IDENT[repo]


def die(msg):
    sys.exit("paas-team: " + msg)


def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return default


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def jload(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default if default is not None else {}


def git(repo, *args, timeout=60):
    try:
        r = subprocess.run(["git", "-C", repo] + list(args), capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, GIT_TERMINAL_PROMPT="0", **identity(repo)))
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:                                   # no git, timeout
        return 124, str(e)


def active():
    t = read(os.path.join(BRAIN, "team")).strip()
    return t if t and NAME.match(t) and os.path.isdir(os.path.join(TEAMS, t)) else ""


def team_dir(team):
    return os.path.join(TEAMS, team)


def plugin_dir(tdir):
    """the plugin folder of a team built by this brain (publish.py): paas-brain-<team>, named by the repository's
    marketplace.json. Another brain's plugin, even with a team.json of its own (brain-sds/), is no such team: it is
    switched as a brain kept as it is (external)."""
    mk = jload(os.path.join(tdir, ".claude-plugin", "marketplace.json"))
    for p in mk.get("plugins", []) if isinstance(mk.get("plugins"), list) else []:
        d = os.path.join(tdir, str(p.get("source", "")).lstrip("./"))
        if os.path.basename(os.path.normpath(d)).startswith("paas-brain-") and os.path.isfile(os.path.join(d, "team.json")):
            return d
    for d in glob.glob(os.path.join(tdir, "paas-brain-*")):
        if os.path.isfile(os.path.join(d, "team.json")):
            return d
    return ""


def paas_team_repo(d):
    """a team built by this brain: team.json in its plugin (paas-brain-<team>/team.json) or, in an older repository, at
    its top beside a paas-brain-<team> plugin; never an external brain"""
    return bool(glob.glob(os.path.join(d, "paas-brain-*", "team.json"))) or (
        os.path.isfile(os.path.join(d, "team.json")) and bool(glob.glob(os.path.join(d, "paas-brain-*"))))


# ---- external brains (any other Claude Code brain, kept as it is) ---------------------------------------------------
EXT_FILE = "paas-external.json"                            # in the clone's .git: never committed, never seen by its owners
EXT_ENV = os.path.join(TEAMS, ".external-env.json")        # which settings.json env keys the active external brain set
PLUGIN_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def external(tdir):
    """the record of an external brain clone ({plugin, marketplace, dir, env, ...}), or None for a paas team / nothing"""
    p = os.path.join(tdir, ".git", EXT_FILE)
    d = jload(p) if os.path.isfile(p) else None
    return d if isinstance(d, dict) and d.get("plugin") and d.get("marketplace") else None


def find_plugin(tdir, name):
    """(marketplace, plugin, plugin folder, files to write) of a Claude Code brain that is not a paas team, or None:
    1. its .claude-plugin/marketplace.json (the first plugin whose source is a folder in the repository);
    2. a folder with .claude-plugin/plugin.json (the repository itself, or up to two levels down): a marketplace.json is
       written for it; 3. plain skills/, agents/ or commands/ at the top: plugin.json and marketplace.json are written"""
    if not os.path.isdir(tdir):
        return None
    root = os.path.realpath(tdir)
    bp = str(brain_json(tdir).get("plugin") or "")              # brain.json names its plugin folder: taken as it says
    if bp:
        d = os.path.realpath(os.path.join(tdir, bp))
        n = str(jload(os.path.join(d, ".claude-plugin", "plugin.json")).get("name", ""))
        if (d == root or d.startswith(root + os.sep)) and PLUGIN_NAME.match(n):
            mk = jload(os.path.join(tdir, ".claude-plugin", "marketplace.json"))
            if any(isinstance(p, dict) and p.get("name") == n for p in mk.get("plugins", []) if isinstance(mk.get("plugins"), list)):
                return str(mk.get("name") or n), n, d, {}
            rel = os.path.relpath(d, tdir)
            return n, n, d, {".claude-plugin/marketplace.json": {
                "name": n, "owner": {"name": "external brain"},
                "plugins": [{"name": n, "source": "./" if rel == "." else "./" + rel.replace(os.sep, "/")}]}}
    mk = jload(os.path.join(tdir, ".claude-plugin", "marketplace.json"))
    for p in mk.get("plugins", []) if isinstance(mk.get("plugins"), list) else []:
        src = p.get("source") if isinstance(p, dict) else None
        if isinstance(src, str) and PLUGIN_NAME.match(str(p.get("name", ""))) and PLUGIN_NAME.match(str(mk.get("name", ""))):
            d = os.path.realpath(os.path.join(tdir, src))
            if (d == root or d.startswith(root + os.sep)) and os.path.isdir(d):
                return mk["name"], p["name"], d, {}
    for pj in sorted(glob.glob(os.path.join(tdir, ".claude-plugin", "plugin.json")) +
                     glob.glob(os.path.join(tdir, "*", ".claude-plugin", "plugin.json")) +
                     glob.glob(os.path.join(tdir, "*", "*", ".claude-plugin", "plugin.json"))):
        n = str(jload(pj).get("name", ""))
        if PLUGIN_NAME.match(n) and not n.startswith("paas-brain-"):
            d = os.path.dirname(os.path.dirname(pj))
            rel = os.path.relpath(d, tdir)
            return n, n, d, {".claude-plugin/marketplace.json": {
                "name": n, "owner": {"name": "external brain"},
                "plugins": [{"name": n, "source": "./" if rel == "." else "./" + rel.replace(os.sep, "/")}]}}
    cl = os.path.join(tdir, ".claude")                          # a project-style brain: its .claude folder as the plugin
    if os.path.isdir(cl) and not os.path.islink(cl) and any(os.path.isdir(os.path.join(cl, x)) for x in ("skills", "agents", "commands")):
        files = {".claude/.claude-plugin/plugin.json": {"name": name, "version": "0.0.0",
                                                          "description": f"{name} (the .claude folder of a brain)"},
                 ".claude-plugin/marketplace.json": {"name": name, "owner": {"name": "external brain"},
                                                     "plugins": [{"name": name, "source": "./.claude"}]}}
        hooks = project_part(tdir, os.path.join(".claude", "settings.json"), "hooks")
        if hooks:                                                # its project hooks, run as the plugin's
            files[".claude/hooks/hooks.json"] = {"hooks": hooks}
        mcp = project_part(tdir, ".mcp.json", "mcpServers")
        if mcp:                                                  # its project MCP servers, as the plugin's
            files[".claude/.mcp.json"] = {"mcpServers": mcp}
        return name, name, cl, files
    if any(os.path.isdir(os.path.join(tdir, x)) for x in ("skills", "agents", "commands")) or os.path.isfile(os.path.join(tdir, "CLAUDE.md")):
        return name, name, tdir, {".claude-plugin/plugin.json": {"name": name, "version": "0.0.0",
                                                                  "description": f"{name} (skills and agents of a brain)"},
                                  ".claude-plugin/marketplace.json": {"name": name, "owner": {"name": "external brain"},
                                                                      "plugins": [{"name": name, "source": "./"}]}}
    return None


PROJECT_DIR = re.compile(r"\$\{?CLAUDE_PROJECT_DIR\}?")


def project_part(tdir, rel, key):
    """a project setting of the brain (.claude/settings.json hooks, .mcp.json servers) for its plugin: the project
    folder becomes the clone (${CLAUDE_PLUGIN_ROOT}/.. from its .claude folder)"""
    d = jload(os.path.join(tdir, rel))
    v = d.get(key) if isinstance(d, dict) else None
    if not isinstance(v, dict) or not v:
        return None
    return json.loads(PROJECT_DIR.sub("${CLAUDE_PLUGIN_ROOT}/..", json.dumps(v)))


def market_plugins(tdir):
    """every plugin of the brain's marketplace.json that lives in its repository: {name: folder}"""
    mk = jload(os.path.join(tdir, ".claude-plugin", "marketplace.json"))
    root = os.path.realpath(tdir)
    out = {}
    for p in mk.get("plugins", []) if isinstance(mk.get("plugins"), list) else []:
        src = p.get("source") if isinstance(p, dict) else None
        if isinstance(src, str) and PLUGIN_NAME.match(str(p.get("name", ""))):
            d = os.path.realpath(os.path.join(tdir, src))
            if (d == root or d.startswith(root + os.sep)) and os.path.isdir(d):
                out[p["name"]] = os.path.relpath(d, tdir)
    return out


DIR_VAR = re.compile(r"\$\{([A-Z][A-Z0-9_]*)(?::-|-)(?:\$HOME|\$\{HOME\}|~)/[^}]*\}"
                     r"|environ\.get\(\s*[\'\"]([A-Z][A-Z0-9_]*)[\'\"]\s*,\s*os\.path\.expanduser\(\s*[\'\"]~/")


def home_vars(plug):
    """variables the plugin's scripts read for a folder under the home directory (TEAM_BRAIN_DIR=${..:-$HOME/team-brain}):
    pointed at the clone, so its hooks find their repository where paas-team put it"""
    out = set()
    for root, dirs, files in os.walk(plug):
        dirs[:] = [d for d in dirs if d not in (".git", "node_modules", "vendor", "__pycache__")]
        for f in files:
            if f.endswith((".sh", ".py", ".js", ".mjs", ".cjs", ".json", ".bash")):
                try:
                    text = open(os.path.join(root, f), encoding="utf-8", errors="replace").read(400000)
                except OSError:
                    continue
                for m in DIR_VAR.finditer(text):
                    v = m.group(1) or m.group(2)
                    if v and not v.startswith(("CLAUDE", "XDG")) and v not in ("HOME", "PATH", "TMPDIR"):
                        out.add(v)
    return sorted(out)


def brain_json(tdir):
    """how the brain describes itself (title, plugin folder, settings, knowledge folders, how knowledge is saved, docs,
    rules); everything optional, without it the layout is detected. Read from, each later one winning key by key:
    1. brain.json at the repository's top (the brain's own);
    2. <teams folder>/<name>.brain.json (root's, on the VM: describes a brain without touching its repository);
    3. .git/paas-brain.json in the clone (this machine only, never pushed)."""
    out = {}
    for f in (os.path.join(tdir, "brain.json"), root_brain_json(tdir), os.path.join(tdir, ".git", "paas-brain.json")):
        d = jload(f) if f and os.path.isfile(f) else None
        if isinstance(d, dict):
            out.update(d)
    return out


def root_brain_json(tdir):
    """root's description of this brain in the VM's teams folder: <name>.brain.json beside its copy there, for the copy
    itself or a member's clone of the same remote"""
    if not os.path.isdir(SOURCES):
        return ""
    real = os.path.realpath(tdir)
    if os.path.dirname(real) == os.path.realpath(SOURCES):
        return os.path.join(SOURCES, os.path.basename(real) + ".brain.json")
    mine = config_origin(tdir)
    if not mine:
        return ""
    for f in sorted(os.listdir(SOURCES)):
        if f.endswith(".brain.json") and same_remote(config_origin(os.path.join(SOURCES, f[:-len(".brain.json")])), mine):
            return os.path.join(SOURCES, f)
    return ""


VAR_REF = re.compile(r"\$\{([A-Z][A-Z0-9_]*)(?::?-[^}]*)?\}")
SECRETISH = re.compile(r"TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|APIKEY|CREDENTIAL")
KNOWLEDGE_DIRS = ("knowledge", "runbooks", "incidents", "notes", "postmortems", "playbooks", "decisions")


def inside(tdir, rel):
    """rel as a folder inside the clone (no .., no absolute, no .git), or "" """
    rel = str(rel or "").strip().strip("/")
    if not rel or rel.startswith(".git") or os.path.isabs(rel) or ".." in rel.split("/"):
        return ""
    d = os.path.realpath(os.path.join(tdir, rel))
    return rel if d.startswith(os.path.realpath(tdir) + os.sep) and os.path.isdir(d) else ""


CONFIG_SKIP = {".git", "docs", "node_modules", "vendor", "third_party", "__pycache__", "inbox", "templates", "tests"} | set(KNOWLEDGE_DIRS)


def config_vars(tdir):
    """{name: default} of every ${NAME} / ${NAME:-default} in the brain's configuration files (JSON, TOML, YAML outside its
    docs and knowledge): the addresses and tokens its servers read from the environment"""
    out = {}
    for root, dirs, files in os.walk(tdir):
        dirs[:] = [d for d in dirs if d not in CONFIG_SKIP and not d.startswith(".") or d == ".claude-plugin"]
        for f in files:
            if not f.endswith((".json", ".toml", ".yaml", ".yml")):
                continue
            pth = os.path.join(root, f)
            try:
                if os.path.getsize(pth) > 400000:
                    continue
                text = open(pth, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            for m in re.finditer(r"\$\{([A-Z][A-Z0-9_]*)(?::?-([^}]*))?\}", text):
                n = m.group(1)
                if not n.startswith(("CLAUDE", "HOME", "PATH", "USER", "PWD")):
                    out.setdefault(n, m.group(2) or "")
    return out


def plugin_team_json(tdir, rec):
    """a team-style brain's own description of itself: team.json in its plugin folder (brain-sds/team.json), or {}"""
    d = os.path.realpath(os.path.join(tdir, rec.get("dir") or "."))
    return jload(os.path.join(d, "team.json")) if d.startswith(os.path.realpath(tdir)) else {}


def ext_layout(tdir, rec, name=None):
    """what the record keeps about an external brain besides its plugin: the settings it reads (brain.json, then every
    ${VAR} its .mcp.json uses, then what was set), its knowledge folders, inbox, templates, how knowledge is saved, its docs"""
    bj = brain_json(tdir)
    plug = os.path.join(tdir, rec["dir"])
    want = {}
    for n, v in (bj.get("settings") or {}).items() if isinstance(bj.get("settings"), dict) else []:
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$", str(n)):
            want[n] = v if isinstance(v, dict) else {"about": str(v)}
    for n in VAR_REF.findall(read(os.path.join(plug, ".mcp.json"))):
        if not n.startswith(("CLAUDE", "HOME", "PATH", "USER")):
            want.setdefault(n, {})
    for n, dflt in config_vars(tdir).items():                     # its configuration files: optional, their default as a hint
        want.setdefault(n, {"optional": True, "about": f"default: {dflt}" if dflt else ""})
    for n in rec.get("env") or {}:
        want.setdefault(n, {})
    schema = [{"name": n, "about": "where this brain's repository is (set for you)" if (rec.get("env") or {}).get(n) == "{dir}" else str(v.get("about", "")),
               "secret": bool(v.get("secret", bool(SECRETISH.search(n)))), "optional": bool(v.get("optional", False)),
               "default": str(v.get("default", "")) if v.get("default") is not None else ""} for n, v in want.items()]
    kn = bj.get("knowledge") if isinstance(bj.get("knowledge"), dict) else {}
    folders = [r for r in (inside(tdir, f) for f in (kn.get("folders") or KNOWLEDGE_DIRS)) if r]
    if not folders and not kn.get("folders"):
        folders = md_folders(tdir, rec)
    inbox = inside(tdir, kn.get("inbox") or "inbox")
    templates = inside(tdir, kn.get("templates") or "templates")
    index = str(kn.get("index") or ("INDEX.md" if os.path.isfile(os.path.join(tdir, "INDEX.md")) else ""))
    tj = plugin_team_json(tdir, rec)                              # a team-style brain (its plugin has a team.json)
    save = str(kn.get("save") or ("push" if tj else "merge-request"))   # a team shares its knowledge straight away
    learn = learn_layout(tdir, bj, save if save in ("merge-request", "push") else "merge-request", str(kn.get("branch", "")), inbox)
    for k in LEARN_KINDS if learn else ():                       # its learning folders are searched with its knowledge
        top = learn[k].split("/")[0]
        if os.path.isdir(os.path.join(tdir, top)) and top not in folders and not any(learn[k].startswith(f + "/") for f in folders):
            folders.append(top)
    tlib = str(tj.get("library") or "") if NAME.match(str(tj.get("library") or "")) else ""
    index = next((r for r in ([bj.get("docs_index")] if bj.get("docs_index") else ["library/docs.db"]) if r and isinstance(r, str)
                  and ".." not in r.split("/") and not r.startswith("/") and os.path.isfile(os.path.join(tdir, r))), "")
    docs = inside(tdir, bj.get("docs") or "docs/upstream") or (inside(tdir, "docs") if not bj.get("docs") and (tlib or index) else "")
    name = name or os.path.basename(tdir)
    return {"title": str(bj.get("title") or tj.get("title") or ""), "description": str(bj.get("description") or tj.get("description") or ""),
            "settings_schema": schema, "docs_index": index if docs else "",
            "knowledge": {"folders": folders, "inbox": inbox, "templates": templates, "index": index,
                          "save": save if save in ("merge-request", "push") else "merge-request",
                          "branch": str(kn.get("branch", ""))},
            "docs": docs, "library": str(bj.get("library") or tlib or (name if docs else "")),
            "rules": rules_file(tdir, rec, bj), "rules_files": rules_list(tdir, rec, bj), "plugins": brain_plugins(tdir, rec, bj),
            "learn": learn}


LEARN_KINDS = ("notes", "runbooks", "incidents", "captures")


def rel_path(tdir, rel):
    """rel as a path inside the repository that may not exist yet (no .., not absolute, not .git), or "" """
    rel = str(rel or "").strip().strip("/")
    if not rel or os.path.isabs(rel) or ".." in rel.split("/") or rel.split("/")[0] == ".git":
        return ""
    p = os.path.normpath(os.path.join(os.path.realpath(tdir), rel))
    return rel if p.startswith(os.path.realpath(tdir) + os.sep) else ""


def learn_layout(tdir, bj, save, branch, inbox):
    """an external brain that keeps what Claude learns in its own git ("learn" in a brain.json: true, "push",
    "merge-request" or {"save", "branch", "notes", "runbooks", "incidents", "captures", "guide"}): its folders (the ones it
    names, else the ones it has: knowledge/<kind> or <kind>, postmortems for incidents, its inbox for captures, else new
    ones under knowledge/), how a saved page reaches its git, and its own guide for learning (LEARNING.md). None when off."""
    raw = bj.get("learn")
    if raw in (None, False, "", "off", "no"):
        return None
    d = raw if isinstance(raw, dict) else {}
    want = d.get("save") if d else (raw if isinstance(raw, str) else None)
    out = {"raw": raw, "save": want if want in ("push", "merge-request") else save,
           "branch": str(d.get("branch") or branch or default_branch(tdir))}
    base = "knowledge/" if os.path.isdir(os.path.join(tdir, "knowledge")) else ""
    extra = {"incidents": ["postmortems"], "captures": [inbox] if inbox else []}
    for k in LEARN_KINDS:
        named = rel_path(tdir, d.get(k))
        out[k] = named or next((c for c in [f"knowledge/{k}", k] + extra.get(k, []) if c and os.path.isdir(os.path.join(tdir, c))), base + k)
    g = rel_path(tdir, d.get("guide")) if d.get("guide") else next(
        (c for c in ("LEARNING.md", "docs/LEARNING.md", ".claude/LEARNING.md") if os.path.isfile(os.path.join(tdir, c))), "")
    out["guide"] = g if g and os.path.isfile(os.path.join(tdir, g)) else ""
    return out


def default_branch(tdir):
    rc, out = git(tdir, "symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD", timeout=5)
    if rc == 0 and out.startswith("origin/"):
        return out[len("origin/"):]
    rc, out = git(tdir, "rev-parse", "--abbrev-ref", "HEAD", timeout=5)
    return out if rc == 0 and out and out != "HEAD" else "main"


def set_learn(team, mode):
    """paas-team learn <brain> [merge-request|push|off]: root on the VM writes it beside the VM copy (every member, nothing
    in the brain's repository changes), anyone else into their own clone's .git/paas-brain.json (this machine only)"""
    tdir = team_dir(team)
    if not external(tdir):
        die(f"{team}: its notes already go to its own git (a team built by this brain)")
    if mode:
        if mode not in ("merge-request", "push", "off"):
            die("learn: merge-request, push or off")
        vm = vm_brain(team, tdir) if os.path.isdir(SOURCES) else ""
        target = os.path.join(SOURCES, vm + ".brain.json") if vm and os.geteuid() == 0 else os.path.join(tdir, ".git", "paas-brain.json")
        d = jload(target)
        if mode == "off":
            d["learn"] = False
        else:
            d["learn"] = dict(d["learn"], save=mode) if isinstance(d.get("learn"), dict) else mode
        write(target, json.dumps(d, indent=2) + "\n")
        os.chmod(target, 0o644 if target.startswith(SOURCES) else 0o600)
        print(f"learn {mode}: written to {target}")
    rec = refresh_layout(tdir)
    lay = rec.get("learn")
    if not lay:
        print(f"{team}: learning OFF: what Claude learns stays in your own notes")
        return
    how = "pushed at once" if lay["save"] == "push" else f"merge requests to {lay['branch']} (from your branch learn/<you>)"
    print(f"{team}: learning ON, {how}; notes {lay['notes']}, runbooks {lay['runbooks']}, incidents {lay['incidents']}, "
          f"captures {lay['captures']}" + (f", its guide {lay['guide']}" if lay["guide"] else "") + "; starts with the next chat")


def rules_list(tdir, rec, bj):
    """the brain's own rule files, read in every session: brain.json "rules" (a file, a folder - every .md in it - or a list
    of them; "" = none), else its rules/ folder when it has Markdown there, plus CLAUDE.md of a brain that is no packaged
    plugin (its .claude folder, plain skills, or only CLAUDE.md): a plugin's repository CLAUDE.md is usually about
    developing that repository, not instructions for its users"""
    if "rules" in bj:
        want = bj.get("rules") if isinstance(bj.get("rules"), list) else [bj.get("rules")]
    else:
        want = ["rules"] if os.path.isdir(os.path.join(tdir, "rules")) else []
        if rec.get("dir") in (".", ".claude"):
            want += [next((r for r in ("CLAUDE.md", ".claude/CLAUDE.md") if os.path.isfile(os.path.join(tdir, r))), "")]
    real = os.path.realpath(tdir)
    out = []
    for w in want:
        r = str(w or "").strip().strip("/")
        p = os.path.realpath(os.path.join(tdir, r))
        if not r or ".." in r.split("/") or r.split("/")[0] == ".git" or not p.startswith(real + os.sep):
            continue
        if os.path.isfile(p) and r.endswith(".md"):
            out.append(r)
        elif os.path.isdir(p) and not os.path.islink(p):
            for dp, dirs, fs in os.walk(p):
                dirs[:] = sorted(d for d in dirs if not d.startswith(".") and not os.path.islink(os.path.join(dp, d)))
                for f in sorted(fs):
                    fp = os.path.join(dp, f)
                    if f.endswith(".md") and not f.lower().startswith("readme") and not os.path.islink(fp) \
                            and os.path.realpath(fp).startswith(real + os.sep):
                        out.append(os.path.relpath(fp, tdir).replace(os.sep, "/"))
    return list(dict.fromkeys(out))[:40]


def rules_file(tdir, rec, bj):
    """the first of the brain's rule files (kept for older readers of the record)"""
    return (rules_list(tdir, rec, bj) or [""])[0]


def brain_plugins(tdir, rec, bj):
    """the plugins switched on with the brain: brain.json "plugins" (names), else every plugin of its marketplace that is
    in the repository, else its one plugin"""
    allp = market_plugins(tdir) if rec.get("marketplace") and os.path.isfile(os.path.join(tdir, ".claude-plugin", "marketplace.json")) else {}
    want = bj.get("plugins") if isinstance(bj.get("plugins"), list) else None
    names = [n for n in (want if want is not None else list(allp)) if n in allp]
    plug = rec.get("plugin")
    return ([plug] if plug else []) + [n for n in names if n != plug]


MD_SKIP = {"skills", "agents", "commands", "hooks", "scripts", "plugins", "src", "lib", "bin", "test", "tests", "docs",
           "templates", "inbox", "node_modules", "vendor", "third_party", "build", "dist", "examples", "assets", "images"}


def md_folders(tdir, rec):
    """top-level folders that are mostly Markdown pages (at least 3, 60% of their files): a brain's knowledge kept under
    another name (wiki/, kb/, ...), when none of the usual folders exists"""
    out = []
    plug = os.path.normpath(rec.get("dir") or ".")
    for d in sorted(os.listdir(tdir)) if os.path.isdir(tdir) else []:
        p = os.path.join(tdir, d)
        if d.startswith(".") or d.lower() in MD_SKIP or d == plug.split(os.sep)[0] or os.path.islink(p) or not os.path.isdir(p):
            continue
        md = total = 0
        for dp, dirs, fs in os.walk(p):
            dirs[:] = [x for x in dirs if not x.startswith(".")]
            for f in fs:
                total += 1
                md += f.lower().endswith(".md")
            if total > 5000:
                break
        if md >= 3 and md >= 0.6 * total:
            out.append(d)
    return out


def save_rec(tdir, rec):
    p = os.path.join(tdir, ".git", EXT_FILE)
    write(p, json.dumps(rec, indent=2) + "\n")
    os.chmod(p, 0o600)


def refresh_layout(tdir):
    rec = external(tdir)
    if rec:
        found = find_plugin(tdir, rec["plugin"]) if rec.get("generated") else None
        for rel, data in (found[3] if found else {}).items():   # only files this tool wrote (untracked, excluded)
            if rel in rec["generated"]:
                write(os.path.join(tdir, rel), json.dumps(data, indent=2) + "\n")
        rec.update(ext_layout(tdir, rec))
        save_rec(tdir, rec)
    return rec


def mark_external(tdir, name):
    """make a fresh clone of another brain usable as a team: write what its marketplace lacks (untracked, excluded from
    git, so the clone stays clean for its own pulls) and the record in .git. False when it holds no plugin, skills or agents."""
    found = find_plugin(tdir, name)
    if not found:
        return False
    mk, plugin, plug, files = found
    excl = os.path.join(tdir, ".git", "info", "exclude")
    lines = read(excl).splitlines()
    for rel, data in files.items():
        dst = os.path.join(tdir, rel)
        if not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            write(dst, json.dumps(data, indent=2) + "\n")
            if "/" + rel not in lines:
                lines.append("/" + rel)
    os.makedirs(os.path.dirname(excl), exist_ok=True)
    write(excl, "\n".join(lines) + "\n")
    old = external(tdir) or {}
    env = dict(old.get("env") or {})
    for v in home_vars(plug):
        env.setdefault(v, "{dir}")
    bs = brain_json(tdir).get("settings")
    for n, v in (bs.items() if isinstance(bs, dict) else []):    # brain.json defaults ("{dir}": the clone)
        if isinstance(v, dict) and v.get("default") not in (None, "") and re.match(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$", str(n)):
            env.setdefault(n, str(v["default"]))
    rec = {"plugin": plugin, "marketplace": mk, "dir": os.path.relpath(plug, tdir), "env": env, "generated": sorted(files)}
    rec.update(ext_layout(tdir, rec, name))
    save_rec(tdir, rec)                                         # it may hold tokens (paas-team env): mode 600
    return True



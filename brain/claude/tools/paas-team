#!/usr/bin/env python3
"""Team profiles of the brain: which brain (rules, skills, agents, knowledge) this account works with, switched in
seconds. A team is a git repository published by brain/teams/publish.py: the plugin paas-brain-<team>/ plus
knowledge/ (notes/, captures/, incidents/, tool-map.md). Each team the person added is a clone under
~/.claude/brain/teams/<team>; the active one is the Claude Code plugin paas-brain-<team> (enabled from that clone, the
same plugin everyone installs) and its knowledge is linked into the brain's usual paths, so every skill, hook and the
web UI keep reading ~/.claude/brain/notes.md, notes/, captures/, incidents/, tool-map.md, environment.md,
persona.md and storage.md as before. Needs the claude command for the plugin steps; without it the rules and the
knowledge are still switched and the plugin is registered at the next `paas-team use`.

  paas-team                        status: active team, local teams, sync state
  paas-team list [--json]          local teams and the ones a source offers
  paas-team add <team> [<source>]  clone the team repository (git url or directory); default source: the VM's
                                   /opt/paas/teams/<team> (its recorded remote when it has one)
  paas-team use <team>             switch to it (added first when needed); then start a new Claude session
  paas-team refresh                re-apply the active team's files (after its repository was updated)
  paas-team sync                   pull / push the active team's knowledge, refresh if its plugin changed
  paas-team remote <team> <url>    set (or change) the git remote of a local team
  paas-team off                    no team: the team's plugin is disabled (its skills, agents and MCP servers with it), the
                                   knowledge files become your own plain files; your own and marketplace skills stay (also: paas-team use none)
  paas-team show <team> [--json]   the team's definition: persona, rules, skills, agents, MCP servers, what could be added
  paas-team env <team> [KEY=VALUE ...] [KEY=]   settings an external brain's plugin reads (its server addresses,
                                   tokens): kept in its clone's .git, put into ~/.claude/settings.json "env" while it is
                                   active ({dir} = the clone); without pairs: the names set
  paas-team edit <team>            change it from JSON on stdin (title, description, persona, rules, environment, skills,
                                   agents, mcp_servers {name: {url, type, token}}, remove_mcp): written into the team's
                                   repository (filled-in servers also into the plugin's .mcp.json), committed, pushed,
                                   re-applied; the Brain tab's team editor uses it
External brains: `paas-team add <name> <git url>` also takes any other Claude Code brain kept as its owners publish it (a
repository with a plugin marketplace, a plugin folder, or plain skills/ and agents/): it is cloned as it is, marked in its
own .git (paas-external.json; a missing marketplace.json is written there as an untracked, git-excluded file), and `use`
installs and enables its plugin instead of a paas-brain one. Its repository is never written: no knowledge links, no
commits or pushes from the brain's hooks (it keeps its own workflow), `sync` only fast-forwards it. Its environment
variables come from `paas-team env`; a variable its scripts read for "where is my repository" (TEAM_BRAIN_DIR=~/..) is set
to the clone when it is added.
Environment: PAAS_TEAMS (source directory: /opt/paas/teams on a multi-user VM, else ~/.claude/brain/team-sources,
written by the installer), CLAUDE_HOME (default ~/.claude).
Standard library, Python 3.9. The only credentials it handles are the team's MCP tokens, which `edit` writes into the
team repository's mcp.json by the team's decision (see brain/teams/README.md); nothing else is ever written."""
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.environ.get("CLAUDE_HOME") or os.path.expanduser("~/.claude")
BRAIN = os.path.join(HOME, "brain")
TEAMS = os.path.join(BRAIN, "teams")
SOURCES = os.environ.get("PAAS_TEAMS") or ("/opt/paas/teams" if os.path.isdir("/opt/paas/teams")
                                            else os.path.join(BRAIN, "team-sources"))   # multi-user VM, else the installer's copies
STATE = os.path.join(TEAMS, ".installed.json")             # skills / agents the active team put into ~/.claude
NAME = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
LINKS = ("notes.md", "environment.md", "tool-map.md", "notes", "captures", "incidents")   # brain paths -> knowledge/
_IDENT = {}


def identity(repo):
    """Who commits: the person's own git identity when configured, else <login>@<host>, so the team repository's history
    says who wrote what (the push may authenticate as the team's GitLab token)."""
    if repo not in _IDENT:
        try:
            r = subprocess.run(["git", "-C", repo, "config", "--get-regexp", r"^user\.(name|email)$"], stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=5)
            have = {l.split()[0] for l in r.stdout.splitlines() if l.strip()}
        except Exception:
            have = set()
        import getpass                              # pwd / getuid do not exist on Windows
        import socket
        try:
            name = getpass.getuser()
        except Exception:
            name = os.environ.get("USER") or os.environ.get("USERNAME") or "brain"
        env = {}
        if "user.name" not in have:
            env.update(GIT_AUTHOR_NAME=name, GIT_COMMITTER_NAME=name)
        if "user.email" not in have:
            env.update(GIT_AUTHOR_EMAIL=f"{name}@{socket.gethostname()}", GIT_COMMITTER_EMAIL=f"{name}@{socket.gethostname()}")
        _IDENT[repo] = env
    return _IDENT[repo]


def die(msg):
    sys.exit("paas-team: " + msg)


def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return default


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def jload(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default if default is not None else {}


def git(repo, *args, timeout=60):
    try:
        r = subprocess.run(["git", "-C", repo] + list(args), capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, GIT_TERMINAL_PROMPT="0", **identity(repo)))
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:                                   # no git, timeout
        return 124, str(e)


def active():
    t = read(os.path.join(BRAIN, "team")).strip()
    return t if t and NAME.match(t) and os.path.isdir(os.path.join(TEAMS, t)) else ""


def team_dir(team):
    return os.path.join(TEAMS, team)


def plugin_dir(tdir):
    """the plugin folder named by the repository's marketplace.json (paas-brain-<team>)"""
    mk = jload(os.path.join(tdir, ".claude-plugin", "marketplace.json"))
    for p in mk.get("plugins", []):
        d = os.path.join(tdir, p.get("source", "").lstrip("./"))
        if os.path.isfile(os.path.join(d, "team.json")):
            return d
    for d in glob.glob(os.path.join(tdir, "paas-brain-*")):
        if os.path.isfile(os.path.join(d, "team.json")):
            return d
    return ""


# ---- external brains (any other Claude Code brain, kept as it is) ---------------------------------------------------
EXT_FILE = "paas-external.json"                            # in the clone's .git: never committed, never seen by its owners
EXT_ENV = os.path.join(TEAMS, ".external-env.json")        # which settings.json env keys the active external brain set
PLUGIN_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def external(tdir):
    """the record of an external brain clone ({plugin, marketplace, dir, env, ...}), or None for a paas team / nothing"""
    p = os.path.join(tdir, ".git", EXT_FILE)
    d = jload(p) if os.path.isfile(p) else None
    return d if isinstance(d, dict) and d.get("plugin") and d.get("marketplace") else None


def find_plugin(tdir, name):
    """(marketplace, plugin, plugin folder, files to write) of a Claude Code brain that is not a paas team, or None:
    1. its .claude-plugin/marketplace.json (the first plugin whose source is a folder in the repository);
    2. a folder with .claude-plugin/plugin.json (the repository itself, or up to two levels down): a marketplace.json is
       written for it; 3. plain skills/, agents/ or commands/ at the top: plugin.json and marketplace.json are written"""
    if not os.path.isdir(tdir):
        return None
    root = os.path.realpath(tdir)
    mk = jload(os.path.join(tdir, ".claude-plugin", "marketplace.json"))
    for p in mk.get("plugins", []) if isinstance(mk.get("plugins"), list) else []:
        src = p.get("source") if isinstance(p, dict) else None
        if isinstance(src, str) and PLUGIN_NAME.match(str(p.get("name", ""))) and PLUGIN_NAME.match(str(mk.get("name", ""))):
            d = os.path.realpath(os.path.join(tdir, src))
            if (d == root or d.startswith(root + os.sep)) and os.path.isdir(d):
                return mk["name"], p["name"], d, {}
    for pj in sorted(glob.glob(os.path.join(tdir, ".claude-plugin", "plugin.json")) +
                     glob.glob(os.path.join(tdir, "*", ".claude-plugin", "plugin.json")) +
                     glob.glob(os.path.join(tdir, "*", "*", ".claude-plugin", "plugin.json"))):
        n = str(jload(pj).get("name", ""))
        if PLUGIN_NAME.match(n) and not n.startswith("paas-brain-"):
            d = os.path.dirname(os.path.dirname(pj))
            rel = os.path.relpath(d, tdir)
            return n, n, d, {".claude-plugin/marketplace.json": {
                "name": n, "owner": {"name": "external brain"},
                "plugins": [{"name": n, "source": "./" if rel == "." else "./" + rel.replace(os.sep, "/")}]}}
    if any(os.path.isdir(os.path.join(tdir, x)) for x in ("skills", "agents", "commands")):
        return name, name, tdir, {".claude-plugin/plugin.json": {"name": name, "version": "0.0.0",
                                                                  "description": f"{name} (skills and agents of an external brain)"},
                                  ".claude-plugin/marketplace.json": {"name": name, "owner": {"name": "external brain"},
                                                                      "plugins": [{"name": name, "source": "./"}]}}
    return None


DIR_VAR = re.compile(r"\$\{([A-Z][A-Z0-9_]*)(?::-|-)(?:\$HOME|\$\{HOME\}|~)/[^}]*\}"
                     r"|environ\.get\(\s*[\'\"]([A-Z][A-Z0-9_]*)[\'\"]\s*,\s*os\.path\.expanduser\(\s*[\'\"]~/")


def home_vars(plug):
    """variables the plugin's scripts read for a folder under the home directory (TEAM_BRAIN_DIR=${..:-$HOME/team-brain}):
    pointed at the clone, so its hooks find their repository where paas-team put it"""
    out = set()
    for root, dirs, files in os.walk(plug):
        dirs[:] = [d for d in dirs if d not in (".git", "node_modules", "vendor", "__pycache__")]
        for f in files:
            if f.endswith((".sh", ".py", ".js", ".mjs", ".cjs", ".json", ".bash")):
                try:
                    text = open(os.path.join(root, f), encoding="utf-8", errors="replace").read(400000)
                except OSError:
                    continue
                for m in DIR_VAR.finditer(text):
                    v = m.group(1) or m.group(2)
                    if v and not v.startswith(("CLAUDE", "XDG")) and v not in ("HOME", "PATH", "TMPDIR"):
                        out.add(v)
    return sorted(out)


def mark_external(tdir, name):
    """make a fresh clone of another brain usable as a team: write what its marketplace lacks (untracked, excluded from
    git, so the clone stays clean for its own pulls) and the record in .git. False when it holds no plugin, skills or agents."""
    found = find_plugin(tdir, name)
    if not found:
        return False
    mk, plugin, plug, files = found
    excl = os.path.join(tdir, ".git", "info", "exclude")
    lines = read(excl).splitlines()
    for rel, data in files.items():
        dst = os.path.join(tdir, rel)
        if not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            write(dst, json.dumps(data, indent=2) + "\n")
            if "/" + rel not in lines:
                lines.append("/" + rel)
    os.makedirs(os.path.dirname(excl), exist_ok=True)
    write(excl, "\n".join(lines) + "\n")
    old = external(tdir) or {}
    env = dict(old.get("env") or {})
    for v in home_vars(plug):
        env.setdefault(v, "{dir}")
    rec = {"plugin": plugin, "marketplace": mk, "dir": os.path.relpath(plug, tdir), "env": env, "generated": sorted(files)}
    write(os.path.join(tdir, ".git", EXT_FILE), json.dumps(rec, indent=2) + "\n")
    os.chmod(os.path.join(tdir, ".git", EXT_FILE), 0o600)          # it may hold tokens (paas-team env)
    return True


def ext_info(tdir):
    """an external brain's data in the shape of info(): title and description from its plugin.json and README"""
    e = external(tdir)
    plug = os.path.join(tdir, e["dir"])
    pj = jload(os.path.join(plug, ".claude-plugin", "plugin.json"))
    title = ""
    for line in read(os.path.join(tdir, "README.md")).splitlines()[:20]:
        if line.startswith("# "):
            title = line[2:].strip()
            break
    skills = sorted(d for d in (os.listdir(os.path.join(plug, "skills")) if os.path.isdir(os.path.join(plug, "skills")) else [])
                    if os.path.isfile(os.path.join(plug, "skills", d, "SKILL.md")))
    agents = sorted(f[:-3] for f in (os.listdir(os.path.join(plug, "agents")) if os.path.isdir(os.path.join(plug, "agents")) else [])
                    if f.endswith(".md"))
    mcp = sorted((jload(os.path.join(plug, ".mcp.json")).get("mcpServers") or {}))
    return {"name": os.path.basename(tdir), "title": title or pj.get("name") or os.path.basename(tdir),
            "description": str(pj.get("description", "")), "version": str(pj.get("version", "")), "skills": skills,
            "agents": agents, "mcp": mcp, "plugin_dir": plug, "external": True, "plugin": e["plugin"],
            "marketplace": e["marketplace"], "env": sorted(e.get("env") or {})}


def plugin_id(team):
    """the Claude Code plugin id of a local team: paas-brain-<team>@paas-brain-<team>, or the external brain's own"""
    e = external(team_dir(team))
    return f"{e['plugin']}@{e['marketplace']}" if e else f"paas-brain-{team}@paas-brain-{team}"


def settings_env(add=None, drop=()):
    """~/.claude/settings.json "env" (Claude Code hands it to every session, its hooks and MCP servers, in the web UI as
    in a terminal, where ~/.bashrc is never read): drop names, add pairs; the file is the person's own (mode 600)"""
    p = os.path.join(HOME, "settings.json")
    try:
        s = json.load(open(p)) if os.path.exists(p) else {}
    except Exception:
        print(f"note: {p} is not valid JSON; the brain's environment variables were not written into it")
        return
    env = s.get("env") if isinstance(s.get("env"), dict) else {}
    for k in drop:
        env.pop(k, None)
    env.update(add or {})
    if env:
        s["env"] = env
    else:
        s.pop("env", None)
    write(p, json.dumps(s, indent=2) + "\n")
    os.chmod(p, 0o600)


def clear_ext_env():
    st = jload(EXT_ENV)
    if st.get("keys"):
        settings_env(drop=st["keys"])
    if os.path.exists(EXT_ENV):
        os.remove(EXT_ENV)


def apply_ext_env(team):
    clear_ext_env()
    env = {k: str(v).replace("{dir}", team_dir(team)) for k, v in ((external(team_dir(team)) or {}).get("env") or {}).items() if v != ""}
    if env:
        settings_env(add=env)
    write(EXT_ENV, json.dumps({"team": team, "keys": sorted(env)}) + "\n")
    return sorted(env)


def unlink_team(t):
    """a paas team's knowledge links go; the person's own files from before the first team come back (else empty ones)"""
    plug = plugin_dir(team_dir(t))
    for name in LINKS:                 # the team's memory stays in its repository (a copy would travel into the next team's)
        p = os.path.join(BRAIN, name)
        k = os.path.join(team_dir(t), "knowledge", name)
        if os.path.islink(p):
            os.remove(p)
        elif is_junction(p):
            os.rmdir(p)                                      # Windows: the junction only, the team's folder stays
        elif os.path.isfile(p) and os.path.isfile(k) and same(p, k):
            os.remove(p)                                     # Windows: the hard link only, the team's file stays
        if os.path.lexists(p):
            continue
        if os.path.lexists(p + ".pre-team"):                   # the person's own, from before the first team
            os.replace(p + ".pre-team", p)
        elif name.endswith(".md"):
            tpl = os.path.join(plug, "brain", name) if plug else ""
            write(p, read(tpl) if os.path.isfile(tpl) else "")
        else:
            os.makedirs(p, exist_ok=True)


def apply_external(team, say=True):
    """switch to an external brain: the previous team's links and plugin go, this brain's plugin is installed and enabled
    from the clone (a local marketplace, read in place), its environment goes into settings.json, a short persona says
    which brain this is; the clone itself is not touched"""
    tdir = team_dir(team)
    t = ext_info(tdir)
    prev = active()
    if prev and prev != team and not external(team_dir(prev)):
        unlink_team(prev)
    if shutil.which("claude"):
        mk, pl = t["marketplace"], t["plugin"]
        rc, out = claude("marketplace", "add", tdir)
        if rc:
            claude("marketplace", "update", mk)
        rc, out = claude("list")
        if f"{pl}@{mk}" in out:
            claude("enable", f"{pl}@{mk}")
        else:
            rc, out = claude("install", f"{pl}@{mk}", "--scope", "user")
            if rc:
                rc, out = claude("install", f"{pl}@{mk}")
            if rc:
                print(f"note: plugin not installed: {out[-200:]}\n      run: claude plugin marketplace add {tdir} && claude plugin install {pl}@{mk}")
        for other in local_teams():
            if other != team:
                claude("disable", plugin_id(other))
    else:
        print("note: claude is not in PATH; the plugin is registered next time (paas-team use " + team + ")")
    apply_mcp({"mcp": []}, installed(), tdir)                 # the previous team's servers and permission rules go
    env = apply_ext_env(team)
    pp = os.path.join(BRAIN, "persona.md")
    if os.path.islink(pp):                                    # multi-user VM: a link to root's shared default, never written through
        os.remove(pp)
    write(pp,
          f"# Persona\nThis session works with the **{t['title']}** brain (Claude Code plugin `{t['plugin']}`, repository "
          f"{tdir}): its skills, agents, hooks and MCP servers come from that plugin; follow its own instructions and keep "
          f"its knowledge where it says (it has its own workflow, for example merge requests). The golden rules still apply.\n")
    write(STATE, json.dumps({"skills": [], "agents": [], "mcp": {}}) + "\n")
    write(os.path.join(BRAIN, "team"), team + "\n")
    write(os.path.join(TEAMS, ".applied"), json.dumps({"team": team, "external": True}) + "\n")
    if say:
        print(f"brain {team} ({t['title']}) active: plugin {t['plugin']}, {len(t['skills'])} skills, {len(t['agents'])} agents"
              + (f", MCP {', '.join(t['mcp'])}" if t["mcp"] else "") + (f", version {t['version']}" if t["version"] else "")
              + f"; external brain, kept as it is in {tdir}" + (f"; settings: {', '.join(env)}" if env else ""))
        print(f"Its skills are /{t['plugin']}:<skill>. Start a new Claude session (or a new chat in the web UI) to work with it.")
    return t


def set_env(team, pairs):
    tdir = team_dir(team)
    e = external(tdir)
    if not e:
        die(f"{team} is not an external brain (paas-team edit changes a team's MCP servers)")
    env = dict(e.get("env") or {})
    for p in pairs:
        if "=" not in p or not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", p.split("=", 1)[0]):
            die(f"env: KEY=VALUE expected, not {p!r}")
        k, v = p.split("=", 1)
        if v == "":
            env.pop(k, None)
        else:
            env[k] = v
    e["env"] = env
    write(os.path.join(tdir, ".git", EXT_FILE), json.dumps(e, indent=2) + "\n")
    os.chmod(os.path.join(tdir, ".git", EXT_FILE), 0o600)
    if active() == team:
        apply_ext_env(team)
    return sorted(env)


def info(tdir):
    """the team's data: repository team.json over the plugin's"""
    if external(tdir):
        return ext_info(tdir)
    plug = plugin_dir(tdir)
    t = jload(os.path.join(plug, "team.json")) if plug else {}
    t.update({k: v for k, v in jload(os.path.join(tdir, "team.json")).items() if k != "skills" and k != "agents"})
    t["plugin_dir"] = plug
    return t


def bump_version(plug):
    """plugin.json and team.json get the library version plus a fingerprint of the plugin's content (the same rule as
    publish.py): Claude Code hands out a new copy of a plugin from a git-hosted marketplace only when the version string
    changes, so every edit of the plugin folder must change it. Returns the new version."""
    h = hashlib.sha1()
    for root, dirs, files in os.walk(plug):
        dirs.sort()
        for f in sorted(files):
            if f in ("plugin.json", "team.json") or "__pycache__" in root:
                continue
            h.update(os.path.relpath(os.path.join(root, f), plug).encode())
            with open(os.path.join(root, f), "rb") as fh:
                h.update(fh.read())
    ver = ""
    for name in ("team.json", os.path.join(".claude-plugin", "plugin.json")):
        pj = os.path.join(plug, name)
        d = jload(pj)
        d["version"] = str(d.get("version", "0")).split("-")[0] + "-" + h.hexdigest()[:8]
        write(pj, json.dumps(d, indent=2, sort_keys=True) + "\n")
        ver = d["version"]
    return ver


def digest(folder):
    """cheap fingerprint of a plugin folder: paths, sizes, mtimes (no hashing of content)"""
    parts = []
    for root, dirs, files in os.walk(folder):
        dirs.sort()
        for f in sorted(files):
            p = os.path.join(root, f)
            try:
                st = os.stat(p)
            except OSError:
                continue
            parts.append("%s:%d:%d" % (os.path.relpath(p, folder), st.st_size, int(st.st_mtime)))
    return hashlib.sha1("\n".join(parts).encode()).hexdigest()[:16]


def remote_of(tdir):
    rc, out = git(tdir, "remote", "get-url", "origin", timeout=5)
    return out if rc == 0 else ""


def local_teams():
    out = {}
    if os.path.isdir(TEAMS):
        for d in sorted(os.listdir(TEAMS)):
            if NAME.match(d) and (plugin_dir(os.path.join(TEAMS, d)) or external(os.path.join(TEAMS, d))):
                out[d] = os.path.join(TEAMS, d)
    return out


def source_teams():
    out = {}
    if os.path.isdir(SOURCES):
        for d in sorted(os.listdir(SOURCES)):
            if NAME.match(d) and (plugin_dir(os.path.join(SOURCES, d)) or find_plugin(os.path.join(SOURCES, d), d)):
                out[d] = os.path.join(SOURCES, d)
    return out


def listing():
    act = active()
    teams = []
    seen = set()
    for name, tdir in local_teams().items():
        t = info(tdir)
        teams.append({"name": name, "title": t.get("title", name), "description": t.get("description", ""),
                      "version": t.get("version", ""), "local": True, "active": name == act,
                      "source": None, "remote": remote_of(tdir) or t.get("remote") or None,
                      "skills": len(t.get("skills", [])), "agents": len(t.get("agents", [])),
                      "mcp": t.get("mcp", []), "external": bool(t.get("external")), "plugin": t.get("plugin"),
                      "env": t.get("env", []),
                      "mcp_added": sorted(jload(os.path.join(t.get("plugin_dir") or plugin_dir(tdir), ".mcp.json")).get("mcpServers", {}))})
        seen.add(name)
    for name, sdir in source_teams().items():
        if name in seen:
            continue
        if not plugin_dir(sdir):                              # another brain root cloned here for everyone
            f = find_plugin(sdir, name)
            pj = jload(os.path.join(f[2], ".claude-plugin", "plugin.json")) if f else {}
            teams.append({"name": name, "title": pj.get("name") or name, "description": str(pj.get("description", "")),
                          "version": str(pj.get("version", "")), "local": False, "active": False, "source": sdir,
                          "remote": remote_of(sdir) or None, "skills": 0, "agents": 0, "mcp": [], "mcp_added": [],
                          "external": True, "plugin": f[1] if f else None, "env": []})
            continue
        t = info(sdir)
        teams.append({"name": name, "title": t.get("title", name), "description": t.get("description", ""),
                      "version": t.get("version", ""), "local": False, "active": False,
                      "source": sdir, "remote": t.get("remote") or None,
                      "skills": len(t.get("skills", [])), "agents": len(t.get("agents", [])),
                      "mcp": t.get("mcp", []), "mcp_added": []})
    return {"active": act or None, "brain": BRAIN, "teams": teams}



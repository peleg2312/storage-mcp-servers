def settings_env(add=None, drop=()):
    """~/.claude/settings.json "env" (Claude Code hands it to every session, its hooks and MCP servers, in the web UI as
    in a terminal, where ~/.bashrc is never read): drop names, add pairs; the file is the person's own (mode 600)"""
    p = os.path.join(HOME, "settings.json")
    try:
        s = json.load(open(p)) if os.path.exists(p) else {}
    except Exception:
        print(f"note: {p} is not valid JSON; the brain's environment variables were not written into it")
        return
    env = s.get("env") if isinstance(s.get("env"), dict) else {}
    for k in drop:
        env.pop(k, None)
    env.update(add or {})
    if env:
        s["env"] = env
    else:
        s.pop("env", None)
    write(p, json.dumps(s, indent=2) + "\n")
    os.chmod(p, 0o600)


def clear_ext_env():
    """an external brain leaves: the settings it put into settings.json, and the docs-local registered for it"""
    st = jload(EXT_ENV)
    if st.get("keys"):
        settings_env(drop=st["keys"])
    if isinstance(st.get("env_prev"), dict) and st["env_prev"]:  # values the person had under the same names: given back
        settings_env(add=st["env_prev"])
    if st.get("docs_mcp"):
        claude_mcp("remove", "-s", "user", "docs-local")
        if isinstance(st.get("docs_prev"), dict):               # the docs-local the person had before: given back
            claude_mcp("add-json", "-s", "user", "docs-local", json.dumps(st["docs_prev"]))
    if os.path.exists(EXT_ENV):
        os.remove(EXT_ENV)


def apply_ext_env(team):
    st = jload(EXT_ENV)                                         # its settings again (paas-team env); its docs-local stays
    if st.get("keys"):
        settings_env(drop=st["keys"])
    if isinstance(st.get("env_prev"), dict) and st["env_prev"]:
        settings_env(add=st["env_prev"])                       # the person's own values back before they are kept again
    env = {k: str(v).replace("{dir}", team_dir(team)) for k, v in ((external(team_dir(team)) or {}).get("env") or {}).items() if v != ""}
    cur = jload(os.path.join(HOME, "settings.json")).get("env")
    cur = cur if isinstance(cur, dict) else {}
    prev = {k: cur[k] for k in env if k in cur}                 # a name the person already uses: kept aside, given back on leaving
    if env:
        settings_env(add=env)
    keep = {k: st[k] for k in ("docs_mcp", "docs_prev") if k in st} if st.get("team") == team and st.get("docs_mcp") else {}
    write(EXT_ENV, json.dumps({"team": team, "keys": sorted(env), "env_prev": prev, **keep}) + "\n")
    return sorted(env)


# the VM's docs service and libraries (a multi-user VM): an external brain root put into /opt/paas/teams gets what a paas
# team has there - its knowledge indexed by the docs service, its docs folder as a team library, a docs-local for each member
EXT_PERSONA = "# Persona\nThis session works with the "   # how the persona an external brain gets starts
DOCS_LIB = os.environ.get("PAAS_DOCS_LIB") or "/opt/paas/library"                 # mcp_stdio.py and the general docs.db
DOCS_INDEX = os.environ.get("PAAS_DOCS_INDEX") or "/var/lib/paas-docs/index"       # <team>.db, kept by the docs service
LIBRARIES = os.environ.get("PAAS_LIBRARIES") or "/opt/paas/libraries"


def same_remote(a, b):
    norm = lambda u: re.sub(r"(\.git)?/*$", "", re.sub(r"://[^/@]+@", "://", (u or "").strip())).lower()
    return bool(a and b) and norm(a) == norm(b)


def config_origin(repo):
    """origin url from .git/config itself: root's copies in the VM's teams folder are another owner's, where git refuses"""
    m = re.search(r'^\s*\[remote\s+"origin"\]\s*$(.*?)(?=^\s*\[|\Z)', read(os.path.join(repo, ".git", "config")), re.M | re.S)
    u = re.search(r"^\s*url\s*=\s*(\S.*?)\s*$", m.group(1), re.M) if m else None
    return u.group(1) if u else ""


def vm_brain(team, tdir=None):
    """the name of this external brain in the VM's teams folder: the same name with the same remote, else the copy whose
    remote is this clone's; "" when root has not put it there"""
    tdir = tdir or team_dir(team)
    mine = config_origin(tdir)
    if not os.path.isdir(SOURCES):
        return ""
    names = [team] + sorted(d for d in os.listdir(SOURCES) if d != team)
    for n in names:
        d = os.path.join(SOURCES, n)
        if not NAME.match(n) or paas_team_repo(d) or not os.path.isdir(os.path.join(d, ".git")):
            continue
        if (n == team and os.path.realpath(d) == os.path.realpath(tdir)) or same_remote(config_origin(d), mine):
            return n
    return ""


def vm_library(vm_name):
    """the external brain's team library on the VM (brain.json "library", else its name), once root built it"""
    lib = str(brain_json(os.path.join(SOURCES, vm_name)).get("library") or vm_name)
    db = os.path.join(LIBRARIES, lib, "docs.db")
    return (lib, db) if NAME.match(lib) and os.path.isfile(db) else ("", "")


def ext_docs_mcp(team):
    """on a multi-user VM: a docs-local for this person (user scope) that searches the brain's own library (or the general
    one) with the knowledge index the docs service keeps for it, as a paas team's plugin has. Registered only where the
    service and the brain's VM copy exist; removed again when the brain is left (clear_ext_env)."""
    server = os.path.join(DOCS_LIB, "mcp_stdio.py")
    if not os.path.isfile(server) or not shutil.which("claude"):
        return ""
    vm = vm_brain(team)
    if not vm:
        print(f"note: {team} is not in {SOURCES} on this VM: no docs index for it (root: install-multiuser.sh --team {team}=<git url>)")
        return ""
    lib, db = vm_library(vm)
    args = [server, "--db", db or os.path.join(DOCS_LIB, "docs.db"), "--team-index", os.path.join(DOCS_INDEX, vm + ".db")]
    prev = (jload(os.path.join(os.path.expanduser("~"), ".claude.json")).get("mcpServers") or {}).get("docs-local")
    if isinstance(prev, dict) and "--team-index" not in (prev.get("args") or []):
        st = jload(EXT_ENV)                                      # the person's own docs-local: kept, given back on leaving
        st["docs_prev"] = prev
        write(EXT_ENV, json.dumps(st) + "\n")
    claude_mcp("remove", "-s", "user", "docs-local")           # one docs-local only: this brain's
    rc, out = claude_mcp("add-json", "-s", "user", "docs-local", json.dumps({"type": "stdio", "command": "python3", "args": args}))
    if rc:
        print(f"note: docs-local not registered: {out[-200:]}")
        return ""
    st = jload(EXT_ENV)
    st.update({"team": team, "docs_mcp": True})
    write(EXT_ENV, json.dumps(st) + "\n")
    return lib or "general library"


def unlink_team(t):
    """a paas team's knowledge links go; the person's own files from before the first team come back (else empty ones)"""
    plug = plugin_dir(team_dir(t))
    for name in LINKS:                 # the team's memory stays in its repository (a copy would travel into the next team's)
        p = os.path.join(BRAIN, name)
        k = os.path.join(team_dir(t), "knowledge", name)
        if os.path.islink(p):
            os.remove(p)
        elif is_junction(p):
            os.rmdir(p)                                      # Windows: the junction only, the team's folder stays
        elif os.path.isfile(p) and os.path.isfile(k) and same(p, k):
            os.remove(p)                                     # Windows: the hard link only, the team's file stays
        if os.path.lexists(p):
            continue
        if os.path.lexists(p + ".pre-team"):                   # the person's own, from before the first team
            os.replace(p + ".pre-team", p)
        elif name.endswith(".md"):
            tpl = os.path.join(plug, "brain", name) if plug else ""
            write(p, read(tpl) if os.path.isfile(tpl) else "")
        else:
            os.makedirs(p, exist_ok=True)


def apply_external(team, say=True):
    """switch to an external brain: the previous team's links and plugin go, this brain's plugin is installed and enabled
    from the clone (a local marketplace, read in place), its environment goes into settings.json, a short persona says
    which brain this is; the clone itself is not touched"""
    tdir = team_dir(team)
    refresh_layout(tdir)                                        # the repository may have changed since it was added
    t = ext_info(tdir)
    prev = active()
    if prev and prev != team:
        unlink_team(prev)                                     # its knowledge links go (a team's or a brain's alike)
    if shutil.which("claude"):
        mk = t["marketplace"]
        rc, out = claude("marketplace", "add", tdir)
        if rc:
            claude("marketplace", "update", mk)
        rc, listed = claude("list")
        for pl in t.get("plugins") or [t["plugin"]]:           # its one plugin, or every plugin of its marketplace
            if f"{pl}@{mk}" in listed:
                claude("enable", f"{pl}@{mk}")
                continue
            rc, out = claude("install", f"{pl}@{mk}", "--scope", "user")
            if rc:
                rc, out = claude("install", f"{pl}@{mk}")
            if rc:
                print(f"note: plugin not installed: {out[-200:]}\n      run: claude plugin marketplace add {tdir} && claude plugin install {pl}@{mk}")
        for other in local_teams():
            if other != team:
                for pid in plugin_ids(other):
                    claude("disable", pid)
    else:
        print("note: claude is not in PATH; the plugin is registered next time (paas-team use " + team + ")")
    apply_mcp({"mcp": []}, installed(), tdir)                 # the previous team's servers and permission rules go
    clear_ext_env()                                           # the previous brain's settings and docs-local
    env = apply_ext_env(team)
    linked = ext_rules(tdir)
    shared = ext_links(tdir, t)
    docs = "" if "docs-local" in (t.get("mcp") or []) else ext_docs_mcp(team)   # its plugin brings its own: never a second
    pp = os.path.join(BRAIN, "persona.md")
    if os.path.islink(pp):                                    # multi-user VM: a link to root's shared default, never written through
        os.remove(pp)
    elif os.path.isfile(pp) and not read(pp).startswith(EXT_PERSONA) and not os.path.lexists(pp + ".pre-team"):
        shutil.copy2(pp, pp + ".pre-team")                    # the persona from before: given back at "no team"
    write(pp,
          f"{EXT_PERSONA}**{t['title']}** brain (Claude Code plugin `{t['plugin']}`, repository "

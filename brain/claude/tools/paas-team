def docs_all(pull=True):
    """root, on the VM (install-shared.sh, and the daily paas-brain-docs timer): every external brain in the teams folder
    brought up to its remote (fast-forward only: the VM copy is never changed by hand), then its docs library built when
    the docs changed. The docs service indexes their knowledge itself (every 10 minutes)."""
    bad = 0
    for n in vm_externals():
        d = os.path.join(SOURCES, n)
        if pull and remote_of(d) and git(d, "status", "--porcelain", "--untracked-files=no", timeout=30)[1]:   # a file root added beside is fine
            print(f"{n}: changed by hand on this VM: not pulled, left as it is (git -C {d} status)")
        elif pull and remote_of(d):
            helper = "/opt/paas/bin/paas-git-credential"
            cfg = ["-c", "credential.helper=" + helper, "-c", "credential.useHttpPath=true"] if os.path.isfile(helper) else []
            r = subprocess.run(["git", *cfg, "-C", d, "pull", "-q", "--ff-only"], capture_output=True, text=True, timeout=600,
                               env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
            msg = re.sub(r"://[^/@]+@", "://", (r.stdout + r.stderr).strip())[-200:]
            print(f"{n}: " + ("up to date with its remote" if r.returncode == 0 else f"pull failed, left as it is: {msg}"))
        try:
            rc = load_docs(n)
        except SystemExit as e:
            print(f"{n}: {e}")
            rc = 1
        bad += 1 if rc else 0
    return 1 if bad else 0


def set_env(team, pairs):

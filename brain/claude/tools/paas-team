def park(p):
    """the person's own file or folder, kept beside the link as <name>.pre-team (never overwritten: a later one is numbered)"""
    dst, n = p + ".pre-team", 1
    while os.path.lexists(dst):
        n += 1
        dst = f"{p}.pre-team{n}"
    os.replace(p, dst)
    return dst


def merge_dir(src, dst):
    """the person's folder into the team's, recursively: files the team lacks move over, identical ones are dropped;
    what stays behind in src differs from the team's copy and is the caller's to keep. Nothing is deleted."""
    for name in sorted(os.listdir(src)):
        a, b = os.path.join(src, name), os.path.join(dst, name)
        if os.path.islink(a):
            continue
        if not os.path.lexists(b):
            shutil.move(a, b)
        elif os.path.isdir(a) and os.path.isdir(b):
            merge_dir(a, b)
            if not os.listdir(a):
                os.rmdir(a)
        elif os.path.isfile(a) and os.path.isfile(b) and read(a) == read(b):
            os.remove(a)


def link(brain_name, target, template=None):
    """~/.claude/brain/<name> -> target. A real file or directory there is moved into the team's knowledge the first
    time a team is used (the person's own notes travel with them): a directory merges (files the team lacks move over,
    recursively), a file replaces a team file that is still the untouched template, else its '- ' lines the team file
    lacks are appended. Whatever differs from the team's copy is kept as <name>.pre-team; nothing is deleted."""
    p = os.path.join(BRAIN, brain_name)
    if os.path.exists(p) and os.path.exists(target) and not os.path.islink(p) and same(p, target):
        return                                               # already a junction / hard link to it (Windows)
    if os.path.islink(p):
        if os.readlink(p) == target:
            return
        os.remove(p)                                         # another team's link: its knowledge stays in its own clone
    elif is_junction(p):
        os.rmdir(p)                                          # another team's junction (Windows): removes the link only
    elif os.path.exists(p):
        if not os.path.exists(target):
            shutil.move(p, target)
        elif os.path.isdir(p) and os.path.isdir(target):
            merge_dir(p, target)
            if os.listdir(p):
                park(p)
            else:
                os.rmdir(p)
        elif os.path.isfile(p) and os.path.isfile(target):
            mine, theirs = read(p), read(target)
            if template and theirs.strip() == read(template).strip():
                write(target, mine)                            # the team file was never filled: the person's wins
            else:
                missing = [l for l in mine.splitlines() if l.startswith("- ") and l not in theirs.splitlines()]
                if missing:
                    write(target, theirs.rstrip("\n") + "\n" + "\n".join(missing) + "\n")
            park(p)
        else:
            park(p)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    make_link(target, p)


def no_symlinks():
    """Windows without the symlink right (no admin, no Developer Mode); PAAS_NO_SYMLINKS=1 makes Linux behave so (tests)"""
    return os.name == "nt" or os.environ.get("PAAS_NO_SYMLINKS") == "1"


def is_junction(p):
    try:
        return bool(getattr(os.path, "isjunction", lambda x: False)(p))
    except OSError:
        return False


def same(a, b):
    try:
        return os.path.samefile(a, b) or os.path.realpath(a) == os.path.realpath(b)
    except OSError:
        return False


def make_link(target, p):
    """a symlink; where Windows refuses one: a directory junction (no admin needed) or, for a file, a hard link (re-made
    by link_files after every git pull, which replaces the file and so breaks the hard link)"""
    if not (os.environ.get("PAAS_NO_SYMLINKS") == "1"):
        try:
            os.symlink(target, p, target_is_directory=os.path.isdir(target))
            return
        except (OSError, NotImplementedError):
            if os.name != "nt":
                raise
    if os.path.isdir(target):
        if os.name == "nt":
            import _winapi
            _winapi.CreateJunction(target, p)
        else:
            os.symlink(target, p)                            # the test stand-in for a junction
    else:
        os.link(target, p)


def link_files(team=None):
    """The knowledge files that are hard links (Windows): a git pull wrote a new file in the clone, so ~/.claude/brain/<file>
    still holds the old one. Lines written there since are added to the clone's file, then the link is made again.
    Symlinks and junctions need nothing. Returns the names re-linked."""
    team = team or active()
    if not team or external(team_dir(team)):
        return []
    k = os.path.join(team_dir(team), "knowledge")
    out = []
    for name in LINKS:
        p, t = os.path.join(BRAIN, name), os.path.join(k, name)
        if not os.path.isfile(t) or os.path.islink(p) or not os.path.isfile(p) or same(p, t):
            continue
        mine, theirs = read(p), read(t)
        extra = [l for l in mine.splitlines() if l.strip() and l not in theirs.splitlines()]
        if extra and os.path.getmtime(p) > os.path.getmtime(t) - 1:
            write(t, theirs.rstrip("\n") + "\n" + "\n".join(extra) + "\n")
        os.remove(p)
        os.link(t, p)
        out.append(name)
    return out


def copy_rule(src, dst):
    if os.path.islink(dst):                                   # multi-user VM: a link to root's shared copy
        os.remove(dst)
    shutil.copy(src, dst)


def installed():
    return jload(STATE, {"skills": [], "agents": [], "mcp": []})


def market_bin():
    return next((p for p in ("/opt/paas/bin/paas-market", os.path.expanduser("~/.local/bin/paas-market"),
                             "/usr/local/bin/paas-market") if os.path.isfile(p)), "")


def market(*args):
    try:
        r = subprocess.run([sys.executable, market_bin()] + list(args), capture_output=True, text=True, timeout=90,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, PAAS_MARKET=os.environ.get("PAAS_MARKET", "/opt/paas/marketplace")))
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 127, str(e)


def mcp_ready(cfg):
    """a server entry of the team's mcp.json with its placeholders filled (HOST, TOKEN) and a command that exists"""
    cmd = cfg.get("command", "")
    if cmd and os.path.isabs(cmd) and not os.path.exists(cmd):
        return False
    return "HOST" not in cfg.get("url", "") and "TOKEN" not in json.dumps(cfg.get("headers", {}))


def claude_mcp(*args):
    try:
        r = subprocess.run(["claude", "mcp"] + list(args), capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 127, str(e)


def plugin_mcp(plug, servers):
    """The plugin's .mcp.json, built from the team repository's mcp.json: docs-local (the team knowledge, and the library
    where it is installed: the VM), docs-http (the VM's docs service for the team over HTTPS: its library and the team's
    knowledge, a native Claude Code connection that needs no Python, for laptops and other machines; the VM's managed
    settings switch it off there, docs-local has the same), plus every http server whose address and token are filled in
    (a placeholder would fail at every session start). Claude Code connects them wherever the plugin is enabled: no
    per-person `claude mcp` command. Returns the server names."""
    out = {"docs-local": {"command": "${CLAUDE_PLUGIN_ROOT}/bin/docs-local"}}
    ds = servers.get("docs-search") or {}
    if isinstance(ds, dict) and ds.get("url") and mcp_ready(ds):
        out["docs-http"] = {"type": "http", "url": ds["url"], **({"headers": ds["headers"]} if ds.get("headers") else {})}
    for n, c in sorted(servers.items()):
        if n in ("docs-local", "docs-search", "docs-http") or not isinstance(c, dict) or c.get("command") or not c.get("url") or not mcp_ready(c):
            continue
        out[n] = {"type": c.get("type") or "http", "url": c["url"], **({"headers": c["headers"]} if c.get("headers") else {})}
    write(os.path.join(plug, ".mcp.json"), json.dumps({"mcpServers": out}, indent=2, sort_keys=True) + "\n")
    return sorted(out)


def apply_mcp(t, old, tdir):
    """The team's MCP servers come with the plugin (its .mcp.json, built by publish.py and the team editor from the team
    repository's mcp.json): nothing is registered per person. Servers an earlier version of this tool registered with
    `claude mcp add-json` or the marketplace are removed; a server still without an address gets a note. Returns {}."""
    prev = old.get("mcp", {})
    prev = {m: "market" for m in prev} if isinstance(prev, list) else prev
    mine = jload(os.path.join(HOME, "paas-market.json")).get("installed", {})
    for m, via in prev.items():
        if via == "team" and shutil.which("claude"):
            claude_mcp("remove", "-s", "user", m)
        elif via == "market" and market_bin() and f"mcp/{m}" in mine:
            market("remove", f"mcp/{m}")
    allow_plugin_tools(t.get("name"), t.get("mcp", []))
    servers = jload(os.path.join(tdir, "mcp.json"))
    for m in t.get("mcp", []):
        if m != "docs-local" and not mcp_ready(servers.get(m) or {}):
            print(f"note: MCP {m}: no address or token in the team's mcp.json yet (Brain tab, Team, Edit)")
    return {}


def allow_plugin_tools(team, mcp):
    """~/.claude/settings.json permissions.allow: the active team plugin's MCP servers. Claude Code names a plugin's tools
    mcp__plugin_paas-brain-<team>_<server>__<tool>, so a bare `mcp__<server>` rule never matches them and a session in the
    default permission mode would ask before every read. The previous teams' rules go; a file that does not parse is left alone."""
    p = os.path.join(HOME, "settings.json")
    try:
        s = json.load(open(p)) if os.path.exists(p) else {}
    except Exception:
        print(f"note: {p} is not valid JSON; the team's permission rules were not written into it")
        return
    allow = s.setdefault("permissions", {}).setdefault("allow", [])
    allow[:] = [r for r in allow if not str(r).startswith("mcp__plugin_paas-brain-")]
    if team:
        allow += [f"mcp__plugin_paas-brain-{team}_{'docs-http' if m == 'docs-search' else m}" for m in mcp]
    write(p, json.dumps(s, indent=2) + "\n")


def claude(*args):
    try:
        r = subprocess.run(["claude", "plugin"] + list(args), capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 127, str(e)


def apply_plugin(team, tdir):
    """plugin mode: this team's plugin installed and enabled from the person's clone (a marketplace added from a local
    path loads in place, so a sync brings new skills to the next session with no update step), every other local team's
    plugin disabled, the pre-team plugin and a user-scope docs-local (the plugin carries its own) removed"""
    if not shutil.which("claude"):
        print("note: claude is not in PATH; the plugin is registered next time (paas-team use " + team + ")")
        return
    name = "paas-brain-" + team
    rc, out = claude("marketplace", "add", tdir)
    if rc:
        claude("marketplace", "update", name)                 # already there (this clone, or the team's GitLab url): fine
    rc, out = claude("list")
    if f"{name}@{name}" in out:
        claude("update", f"{name}@{name}")
        claude("enable", f"{name}@{name}")
    else:
        rc, out = claude("install", f"{name}@{name}", "--scope", "user")
        if rc:
            rc, out = claude("install", f"{name}@{name}")
        if rc:
            print(f"note: plugin not installed: {out[-200:]}\n      run: claude plugin marketplace add {tdir} && claude plugin install {name}@{name}")
    for other in local_teams():
        if other != team:
            claude("disable", plugin_id(other))
    if "paas-brain@paas-brain" in out:                        # the pre-team laptop plugin
        claude("uninstall", "paas-brain@paas-brain")
    claude_mcp("remove", "-s", "user", "docs-local")           # one docs-local only: the plugin's (same library, plus the knowledge index)
    mp = os.path.join(HOME, "paas-market.json")                 # the marketplace's record of it goes too, so its list stays true
    st = jload(mp)
    if "mcp/docs-local" in st.get("installed", {}):
        st["installed"].pop("mcp/docs-local")
        write(mp, json.dumps(st, indent=2) + "\n")
    strip_settings_hooks()


HOOK_SCRIPTS = ("block-write-tools.py", "docs-hints.py", "py-lint.py", "notes-check.py", "capture-nudge.py", "docs-leads.py", "session-start.py")


def strip_settings_hooks():
    """~/.claude/settings.json of an install made without --team carries the brain's hooks; the plugin runs them now"""
    p = os.path.join(HOME, "settings.json")
    s = jload(p)
    hooks = s.get("hooks") or {}
    changed = False
    for ev in list(hooks):
        groups = hooks[ev]
        for e in list(groups):
            keep = [h for h in e.get("hooks", []) if not any(h.get("command", "").endswith("/hooks/" + sc) for sc in HOOK_SCRIPTS)]
            if len(keep) != len(e.get("hooks", [])):
                changed = True
                e["hooks"] = keep
            if not e["hooks"]:
                groups.remove(e)
        if not groups:
            hooks.pop(ev)
    if changed:
        s["hooks"] = hooks
        write(p, json.dumps(s, indent=2) + "\n")


def apply(team, say=True, skills=True, plugin_cmds=True, persona=True):
    tdir = team_dir(team)
    if external(tdir):
        return apply_external(team, say=say) if plugin_cmds else ext_info(tdir)
    clear_ext_env()                                           # an external brain's settings leave with it
    plug = plugin_dir(tdir)
    if not plug:
        die(f"team {team} is not added (paas-team add {team} [<source>])")
    t = info(tdir)
    k = os.path.join(tdir, "knowledge")
    for d in ("notes", "captures", "incidents"):
        os.makedirs(os.path.join(k, d), exist_ok=True)
    first = not read(os.path.join(BRAIN, "team")).strip()     # first team ever: the person's files move in
    os.makedirs(BRAIN, exist_ok=True)
    for name in LINKS:
        link(name, os.path.join(k, name), os.path.join(plug, "brain", name) if name.endswith(".md") else None)
    for name in ("notes.md", "environment.md", "tool-map.md"):    # the team's memory files start from the templates
        if not os.path.exists(os.path.join(k, name)):
            shutil.copy(os.path.join(plug, "brain", name), os.path.join(k, name))
    if persona:
        copy_rule(os.path.join(plug, "brain", "persona.md"), os.path.join(BRAIN, "persona.md"))
    copy_rule(os.path.join(plug, "brain", "storage.md"), os.path.join(BRAIN, "storage.md"))
    mine, copy = os.path.join(plug, "bin", "paas-team"), os.path.join(HOME, "tools", "paas-team")
    if os.path.isfile(mine) and os.path.isfile(copy) and read(mine) != read(copy):   # the copy follows the plugin's version
        shutil.copy(mine, copy)
        os.chmod(copy, 0o755)
    if not os.path.exists(os.path.join(BRAIN, "coding.md")):
        shutil.copy(os.path.join(plug, "brain", "coding.md"), os.path.join(BRAIN, "coding.md"))
    if skills and plugin_cmds:                                # a refresh after a sync needs none: the plugin loads in place;
        apply_plugin(team, tdir)                              # a bootstrap from inside the plugin already provides them
    write(STATE, json.dumps({"skills": [], "agents": [], "mcp": apply_mcp(t, installed(), tdir)}, indent=2) + "\n")
    write(os.path.join(BRAIN, "team"), team + "\n")
    write(os.path.join(TEAMS, ".applied"), json.dumps({"team": team, "digest": digest(plug), "version": t.get("version", "")}) + "\n")
    chats = os.path.expanduser("~/chats/CLAUDE.md")          # regenerated by the session-start hook from the new rules
    if os.path.exists(chats) and read(chats)[:40].startswith("<!-- generated by the brain"):
        os.utime(os.path.join(BRAIN, "storage.md"), None)
    ignore = os.path.join(BRAIN, ".gitignore")                # the old whole-brain history never tracks the team clones
    if os.path.isdir(os.path.join(BRAIN, ".git")):
        lines = read(ignore).splitlines()
        for l in ("teams/", "team-sources/", "team", "persona.md"):
            if l not in lines:
                lines.append(l)
        write(ignore, "\n".join(lines) + "\n")
    if say:
        mcp = list(installed().get("mcp") or [])
        print(f"team {team} ({t.get('title', team)}) active: {len(t.get('skills', []))} skills, "
              f"{len(t.get('agents', []))} agents" + (f", MCP {', '.join(mcp)}" if mcp else "")
              + f", version {t.get('version', '?')}; knowledge in {k}" + (" (your notes moved into it)" if first else ""))
        print("Start a new Claude session (or a new chat in the web UI) to work with it.")
    return t


def use(team, source=None):
    add(team, source)
    apply(team)


def bootstrap(team, source):
    """Called by the plugin's own session-start hook on a bare `claude plugin install`: the team's knowledge clone, the
    links, persona / rules, the core rules as ~/.claude/brain/main.md with one import line in the person's CLAUDE.md,
    and this tool in ~/.claude/tools. No `claude plugin` command (the plugin is installed and enabled already)."""
    add(team, source, quiet=True)
    t = apply(team, say=False, skills=False, persona=False)
    plug = plugin_dir(team_dir(team))
    shutil.copy(os.path.join(plug, "brain", "CLAUDE.md"), os.path.join(BRAIN, "main.md"))
    md = os.path.join(HOME, "CLAUDE.md")
    if "@~/.claude/brain/main.md" not in read(md).split():
        with open(md, "a", encoding="utf-8") as f:
            f.write("\n@~/.claude/brain/main.md\n")
    tools = os.path.join(HOME, "tools")
    os.makedirs(tools, exist_ok=True)
    shutil.copy(os.path.abspath(__file__), os.path.join(tools, "paas-team"))
    os.chmod(os.path.join(tools, "paas-team"), 0o755)
    copy_rule(os.path.join(plug, "brain", "persona.md"), os.path.join(BRAIN, "persona.md"))   # last: the hook's "done" mark
    print(f"team {team} ({t.get('title', team)}) set up from the plugin: knowledge in {os.path.join(team_dir(team), 'knowledge')}, "
          f"rules imported from ~/.claude/brain/main.md; tool: ~/.claude/tools/paas-team")


def refresh():
    """the whole apply again (after a repository update): plugin commands included"""
    t = active()
    if not t:
        die("no active team (paas-team use <team>)")
    apply(t, say=False)
    print(f"team {t}: re-applied")


def relink(background=False):
    """the cheap re-apply after a sync pulled a new plugin (session start): files and links, then one `claude plugin
    update` so a plugin installed from the team's GitLab marketplace (bootstrap, laptops) picks the new version up too; a
    plugin read in place from the clone needs nothing. background: the update runs detached (it fetches the marketplace and
    can take longer than a session-start hook may wait); a failed update is retried at the next session start"""
    t = active()
    if not t or external(team_dir(t)):
        return
    apply(t, say=False, plugin_cmds=False)
    if not shutil.which("claude"):
        return
    if background:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "plugin-update"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        plugin_update()


def plugin_update():
    """`claude plugin update` of the active team's plugin; when it fails (GitLab not reachable, timed out) the applied mark
    is cleared, so needs-refresh says yes again at the next session start instead of never"""
    t = active()
    if not t:
        return 1
    # `claude plugin update` answers from the marketplace copy Claude Code already has: fetch the team's marketplace first,
    # or a laptop stays on its first version (a local folder marketplace, the VM, needs no fetch: the update finds it current)
    e = external(team_dir(t))
    mk = e["marketplace"] if e else f"paas-brain-{t}"
    rc, out = claude("marketplace", "update", mk)
    if rc == 0:
        rc, out = claude("update", plugin_id(t))
    if rc != 0:
        st = jload(os.path.join(TEAMS, ".applied"))
        st["digest"] = ""
        write(os.path.join(TEAMS, ".applied"), json.dumps(st) + "\n")
        print(f"team {t}: plugin update failed, retried at the next session start: {out[-200:]}")
    return rc


def needs_refresh():
    """True when the active team's plugin changed since it was applied (after a sync pulled a new one)"""
    t = active()
    if not t or external(team_dir(t)):
        return False                                          # an external brain loads in place: its own hooks pull it
    plug = plugin_dir(team_dir(t))
    st = jload(os.path.join(TEAMS, ".applied"))
    return bool(plug) and (st.get("team") != t or st.get("digest") != digest(plug))


def sync():
    t = active()
    if not t:
        print("brain: no active team")
        return 0
    if external(team_dir(t)):                                 # its own workflow: never a commit or a push from here
        tdir = team_dir(t)
        if git(tdir, "status", "--porcelain", timeout=10)[1]:
            print(f"brain {t}: local changes in {tdir}, not pulled (it is an external brain: its own tools commit)")
            return 0
        rc, out = git(tdir, "pull", "--ff-only", "-q", timeout=60)
        print(f"brain {t}: up to date with its repository" if rc == 0 else f"brain {t}: pull failed: {out[-200:]}")
        return 1 if rc else 0
    nc = next((p for p in (os.path.join(HOME, "hooks", "notes-check.py"), "/opt/paas/hooks/notes-check.py",
                           os.path.join(plugin_dir(team_dir(t)), "hooks", "notes-check.py")) if os.path.isfile(p)), "")
    if nc:
        try:
            r = subprocess.run([sys.executable, nc, "--sync"], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
            print(r.stdout.strip() or r.stderr.strip()[-200:])
            rc = r.returncode
        except subprocess.TimeoutExpired:
            print("brain: sync still running after 60 s (remote not answering?); try again later")
            rc = 1
    else:
        rc, out = git(team_dir(t), "pull", "--rebase", "--autostash", "-q", timeout=60)
        print("brain: in sync" if rc == 0 else out[-200:])
    if needs_refresh():
        relink()
        print(f"team {t}: updated to version {info(team_dir(t)).get('version', '?')} (new session needed)")
    return 1 if rc else 0


def set_remote(team, url):
    tdir = team_dir(team)
    if not plugin_dir(tdir):
        die(f"team {team} is not added")
    rc, _ = git(tdir, "remote", "get-url", "origin", timeout=5)
    git(tdir, "remote", "set-url" if rc == 0 else "add", "origin", url, timeout=5)
    print(f"team {team}: remote {url} (first sync: paas-team sync)")


def off():
    t = active()
    if not t:
        print("no active team")
        return
    if external(team_dir(t)):
        if shutil.which("claude"):
            claude("disable", plugin_id(t))
        clear_ext_env()
        default = "/opt/paas/brain/persona.md"                # the VM's default persona (no team chosen)
        if os.path.isfile(default):
            copy_rule(default, os.path.join(BRAIN, "persona.md"))
        write(STATE, json.dumps({"skills": [], "agents": [], "mcp": {}}) + "\n")
        os.remove(os.path.join(BRAIN, "team"))
        print(f"no team: the {t} brain's plugin is disabled and its settings removed; its clone stays in {team_dir(t)}.")
        return
    plug = plugin_dir(team_dir(t))
    for name in LINKS:                 # the team's memory stays in its repository (a copy would travel into the next team's)
        p = os.path.join(BRAIN, name)
        k = os.path.join(team_dir(t), "knowledge", name)
        if os.path.islink(p):
            os.remove(p)
        elif is_junction(p):
            os.rmdir(p)                                      # Windows: the junction only, the team's folder stays
        elif os.path.isfile(p) and os.path.isfile(k) and same(p, k):
            os.remove(p)                                     # Windows: the hard link only, the team's file stays
        if os.path.lexists(p):
            continue
        if os.path.lexists(p + ".pre-team"):                   # the person's own, from before the first team
            os.replace(p + ".pre-team", p)
        elif name.endswith(".md"):
            tpl = os.path.join(plug, "brain", name) if plug else ""
            write(p, read(tpl) if os.path.isfile(tpl) else "")
        else:
            os.makedirs(p, exist_ok=True)
    old = installed()
    if shutil.which("claude"):
        claude("disable", f"paas-brain-{t}@paas-brain-{t}")
    apply_mcp({"mcp": []}, old, team_dir(t))
    write(STATE, json.dumps({"skills": [], "agents": [], "mcp": {}}) + "\n")
    os.remove(os.path.join(BRAIN, "team"))
    print(f"no team: {t}'s plugin is disabled, its skills, agents and MCP servers with it (your own and marketplace ones stay); persona.md, storage.md and the "
          f"knowledge files are plain copies in {BRAIN} now, yours to edit; the team clone stays in {team_dir(t)}.\n"
          "Add skills from the marketplace (paas-market add skill/<name>, or the Market tab); paas-team use <team> joins a team again.")


def candidates(kind):
    """where a skill folder / agent file of a given name can be taken from when a team adds it: the person's own
    ~/.claude copy (own or marketplace), the VM's marketplace, every team source and every local team"""
    out = []
    ext = "" if kind == "skills" else ".md"
    act = active()
    roots = [(os.path.join(HOME, kind), "mine"), (os.path.join(os.environ.get("PAAS_MARKET", "/opt/paas/marketplace"), "items", kind), "marketplace")]
    for base in (SOURCES, TEAMS):
        for d in sorted(glob.glob(os.path.join(base, "*", "paas-brain-*", kind))):
            roots.append((d, "team " + d.split(os.sep)[-3]))
    seen = set()
    for root, src in roots:
        if not os.path.isdir(root):
            continue
        for n in sorted(os.listdir(root)):
            name = n[:-3] if ext and n.endswith(ext) else n
            path = os.path.join(root, n)
            ok = os.path.isfile(os.path.join(path, "SKILL.md")) if kind == "skills" else (n.endswith(ext) and os.path.isfile(path))
            if ok and NAME.match(name.lower()) and name not in seen:
                seen.add(name)
                if src == "mine" and f"{kind[:-1]}/{name}" in jload(os.path.join(HOME, "paas-market.json")).get("installed", {}):
                    src = "marketplace"
                out.append({"name": name, "source": src, "path": path})
    return out


def show(team):
    if external(team_dir(team)):
        t = ext_info(team_dir(team))
        return dict(t, local=True, remote=remote_of(team_dir(team)) or None, active=active() == team, persona="", rules="",
                    environment="", mcp_servers={}, available_skills=[], available_agents=[])
    tdir = team_dir(team) if plugin_dir(team_dir(team)) else os.path.join(SOURCES, team)
    plug = plugin_dir(tdir)
    if not plug:
        die(f"no team {team}")
    t = info(tdir)
    servers = jload(os.path.join(tdir, "mcp.json"))
    b = os.path.join(plug, "brain")
    return {"name": team, "title": t.get("title", team), "description": t.get("description", ""), "version": t.get("version", ""),
            "local": tdir == team_dir(team), "remote": remote_of(tdir) or t.get("remote") or None, "active": active() == team,
            "persona": read(os.path.join(b, "persona.md")), "rules": read(os.path.join(b, "storage.md")),
            "environment": read(os.path.join(b, "environment.md")),
            "skills": t.get("skills", []), "agents": t.get("agents", []), "mcp": t.get("mcp", []),
            "mcp_servers": {n: {"type": c.get("type", "http" if c.get("url") else "stdio"), "url": c.get("url", ""),
                                "command": c.get("command", ""), "token_set": "Authorization" in c.get("headers", {}) and "TOKEN" not in json.dumps(c.get("headers")),
                                "configured": mcp_ready(c)} for n, c in servers.items()},
            "available_skills": [{"name": c["name"], "source": c["source"]} for c in candidates("skills")],
            "available_agents": [{"name": c["name"], "source": c["source"]} for c in candidates("agents")]}


def edit(team, change):
    """apply a JSON change to the team's repository (local clone; added first when needed), commit, push, re-apply"""
    if external(team_dir(team)):
        die(f"{team} is an external brain: change it in its own repository (its settings: paas-team env {team} KEY=VALUE)")
    add(team, None, quiet=True)
    tdir = team_dir(team)
    if remote_of(tdir):                                       # edit on top of what the team has now
        git(tdir, "add", "-A", timeout=30)
        git(tdir, "commit", "-q", "-m", f"team {team}: before an edit", timeout=30)
        rc, out = git(tdir, "pull", "--rebase", "-q", timeout=60)
        if rc and git(tdir, "diff", "--name-only", "--diff-filter=U", timeout=5)[1]:
            git(tdir, "rebase", "--abort", timeout=10)
            die("the team repository changed in a way that clashes with this clone; run paas-team sync, resolve the "
                "conflict it names, then edit again")
        elif rc:
            git(tdir, "rebase", "--abort", timeout=10)        # offline, or the remote did not answer: edit locally, push later
    plug = plugin_dir(tdir)
    b = os.path.join(plug, "brain")
    pj = os.path.join(plug, "team.json")
    t = jload(pj)
    rj = os.path.join(tdir, "team.json")
    r = jload(rj)
    for k in ("title", "description"):
        if isinstance(change.get(k), str):
            t[k] = r[k] = change[k].strip()
    for k, f in (("persona", "persona.md"), ("rules", "storage.md"), ("environment", "environment.md")):
        if isinstance(change.get(k), str) and change[k].strip():
            write(os.path.join(b, f), change[k].rstrip() + "\n")
    for kind in ("skills", "agents"):
        if not isinstance(change.get(kind), list):
            continue
        want = [str(n) for n in dict.fromkeys(change[kind]) if NAME.match(str(n).lower())]
        have = set(t.get(kind, []))
        cand = {c["name"]: c["path"] for c in candidates(kind)}
        ext = "" if kind == "skills" else ".md"
        for n in have - set(want):
            p = os.path.join(plug, kind, n + ext)
            shutil.rmtree(p, ignore_errors=True) if kind == "skills" else (os.path.isfile(p) and os.remove(p))
        for n in want:
            dst = os.path.join(plug, kind, n + ext)
            if os.path.exists(dst):
                continue
            src = cand.get(n)
            if not src:
                die(f"{kind[:-1]} {n!r} is nowhere to be found (your ~/.claude, the marketplace, another team)")
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copytree(src, dst, ignore=shutil.ignore_patterns(".user-skill", "__pycache__")) if kind == "skills" else shutil.copy(src, dst)
        t[kind] = want
    servers = jload(os.path.join(tdir, "mcp.json"))
    for n in change.get("remove_mcp") or []:
        servers.pop(str(n), None)
    for n, c in (change.get("mcp_servers") or {}).items():
        if not NAME.match(str(n).lower()) or not isinstance(c, dict):
            continue
        cur = dict(servers.get(n) or {})
        if c.get("command"):
            cur = {"type": "stdio", "command": str(c["command"]), "args": [str(a) for a in c.get("args") or []]}
        elif c.get("url"):
            cur = {"type": c.get("type") or "http", "url": str(c["url"]).strip(), **({"headers": cur["headers"]} if cur.get("headers") else {})}
        if "token" in c:                                      # a string sets it, null / empty removes it, absent keeps it
            tok = str(c["token"] or "").strip()
            was = str((servers.get(n) or {}).get("headers", {}).get("Authorization", ""))
            bare = bool(was) and not was.startswith("Bearer ")   # the catalog shape (or the admin) chose a bare secret: keep it so
            if tok:
                cur["headers"] = {"Authorization": tok if bare or tok.startswith("Bearer ") else "Bearer " + tok}
            else:
                cur.pop("headers", None)
        servers[n] = cur
    removed = {str(n) for n in change.get("remove_mcp") or []}
    t["mcp"] = ["docs-local"] + [n for n in dict.fromkeys(list(t.get("mcp", [])) + list(servers)) if n != "docs-local" and n not in removed]
    r["mcp"] = t["mcp"]
    write(os.path.join(tdir, "mcp.json"), json.dumps(servers, indent=2, sort_keys=True) + "\n")
    plugin_mcp(plug, servers)                                # the plugin connects the filled-in servers for every member
    write(pj, json.dumps(t, indent=2, sort_keys=True) + "\n")
    r["version"] = bump_version(plug)                        # a new version string: plugin-mode members get the new copy
    write(rj, json.dumps(r, indent=2, sort_keys=True) + "\n")
    git(tdir, "add", "-A", timeout=30)
    git(tdir, "commit", "-q", "-m", f"brain tab: team {team} edited", timeout=30)
    pushed = ""
    if remote_of(tdir):
        rc, out = git(tdir, "push", "-q", timeout=60)
        pushed = "pushed to the team repository" if rc == 0 else "not pushed (the next sync retries): " + (out.splitlines()[-1][:120] if out else "?")
    else:
        pushed = "no remote: the change stays on this machine"
    if active() == team:
        apply(team, say=False)
    print(f"edited team {team}: {len(t.get('skills', []))} skills, {len(t.get('agents', []))} agents, MCP {', '.join(t['mcp'])}; {pushed}"
          + ("; re-applied, a new Claude session uses it" if active() == team else ""))


def status():
    d = listing()
    act = d["active"]
    if not act:
        print("team: none active" + (f" ({len(d['teams'])} available: " + ", ".join(x["name"] for x in d["teams"]) + ")" if d["teams"] else ""))
        return
    t = next(x for x in d["teams"] if x["name"] == act)
    print(f"team: {act} ({t['title']}), version {t['version']}, {t['skills']} skills, {t['agents']} agents")
    tdir = team_dir(act)
    if t["remote"]:
        rc, out = git(tdir, "rev-list", "--left-right", "--count", "HEAD...@{upstream}", timeout=5)
        a, b = (out.split() + ["?", "?"])[:2] if rc == 0 else ("?", "?")
        print(f"remote: {t['remote']} ({'in sync' if (a, b) == ('0', '0') else a + ' ahead, ' + b + ' behind'})")
    else:
        print("remote: none (paas-team remote %s <url>)" % act)
    if needs_refresh():
        print("the team repository changed since it was applied: paas-team refresh")
    others = [x["name"] for x in d["teams"] if x["name"] != act]
    if others:
        print("other teams: " + ", ".join(others) + "   (paas-team use <team>)")


def main(a):
    cmd = a[0] if a else "status"
    if cmd == "status":
        status()
    elif cmd == "list":
        d = listing()
        if "--json" in a:
            print(json.dumps(d))
        else:
            for t in d["teams"]:
                print("%s %-8s %-28s %s%s%s" % ("*" if t["active"] else " ", t["name"], t["title"][:28],
                                               "local" if t["local"] else "available", f", {t['version']}" if t["version"] else "",
                                               f", external brain (plugin {t.get('plugin')})" if t.get("external") else ""))
            if not d["teams"]:
                print("no teams (paas-team add <team> <git url>)")
    elif cmd == "add" and len(a) >= 2:
        add(a[1], a[2] if len(a) > 2 else None)
        print(f"team {a[1]} added ({team_dir(a[1])}); paas-team use {a[1]} switches to it")
    elif cmd == "use" and len(a) >= 2 and a[1] in ("none", "off"):
        off()
    elif cmd == "use" and len(a) >= 2:
        use(a[1], a[2] if len(a) > 2 else None)
    elif cmd == "show" and len(a) >= 2:
        d = show(a[1])
        if "--json" in a:
            print(json.dumps(d))
        else:
            print(f"{d['name']}: {d['title']} ({d['version']}); skills {len(d['skills'])}, agents {len(d['agents'])}, MCP {', '.join(d['mcp'])}")
            for n, c in d["mcp_servers"].items():
                print(f"  {n}: {c['url'] or c['command']} {'ready' if c['configured'] else 'HOST / TOKEN not filled in'}")
    elif cmd == "env" and len(a) >= 2:
        names = set_env(a[1], a[2:])
        print(f"brain {a[1]}: settings {', '.join(names) or 'none'}" + (" (applied: start a new chat)" if active() == a[1] and a[2:] else ""))
    elif cmd == "edit" and len(a) >= 2:
        try:
            change = json.load(sys.stdin)
        except ValueError:
            die("edit: JSON expected on stdin")
        edit(a[1], change)
    elif cmd == "bump" and len(a) >= 2:
        plug = plugin_dir(team_dir(a[1]))
        plug or die(f"team {a[1]} is not added")
        print(bump_version(plug))
    elif cmd == "bootstrap" and len(a) >= 3:
        bootstrap(a[1], a[2])
    elif cmd == "refresh":
        refresh()
    elif cmd == "relink":
        relink(background="--background" in a)
    elif cmd == "plugin-update":
        sys.exit(plugin_update())
    elif cmd == "link-files":
        for n in link_files():
            print(f"re-linked {n}")
    elif cmd == "sync":
        sys.exit(sync())
    elif cmd == "remote" and len(a) >= 3:
        set_remote(a[1], a[2])
    elif cmd == "off":
        off()
    elif cmd == "needs-refresh":
        sys.exit(0 if needs_refresh() else 1)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])

#!/usr/bin/env python3
"""Team profiles of the brain: which brain (rules, skills, agents, knowledge) this account works with, switched in
seconds. A team is a git repository published by brain/teams/publish.py: the plugin paas-brain-<team>/ plus
knowledge/ (notes/, captures/, incidents/, tool-map.md). Each team the person added is a clone under
~/.claude/brain/teams/<team>; the active one is linked into the brain's usual paths, so every skill, hook and the
web UI keep reading ~/.claude/brain/notes.md, notes/, captures/, incidents/, tool-map.md, environment.md,
persona.md and storage.md as before.

  paas-team                        status: active team, mode, local teams, sync state
  paas-team list [--json]          local teams and the ones a source offers
  paas-team add <team> [<source>]  clone the team repository (git url or directory); default source: the VM's
                                   /opt/paas/teams/<team> (its recorded remote when it has one)
  paas-team use <team>             switch to it (added first when needed); then start a new Claude session
  paas-team refresh                re-apply the active team's files (after its repository was updated)
  paas-team sync                   pull / push the active team's knowledge, refresh if its plugin changed
  paas-team remote <team> <url>    set (or change) the git remote of a local team
  paas-team off                    no team: the team's skills and agents leave ~/.claude, the knowledge files become
                                   plain files again; your own and marketplace skills stay (also: paas-team use none)
  paas-team export [<team>] [<dir>]  zip of the team's plugin (marketplace + install-team.sh) for a laptop without
                                   GitLab access, into ~/storage-reports (the Reports tab) or <dir>
  paas-team show <team> [--json]   the team's definition: persona, rules, skills, agents, MCP servers, what could be added
  paas-team edit <team>            change it from JSON on stdin (title, description, persona, rules, environment, skills,
                                   agents, mcp_servers {name: {url, type, token}}, remove_mcp): written into the team's
                                   repository, committed, pushed, re-applied; the Brain tab's team editor uses it
  paas-team mode files|plugin      plugin (the default wherever claude is installed): the team is the Claude Code plugin
                                   paas-brain-<team>, the same install as everyone's; files: skills copied into ~/.claude,
                                   for a machine without the claude command
Environment: PAAS_TEAMS (source directory: /opt/paas/teams on a multi-user VM, else ~/.claude/brain/team-sources,
written by the installer), CLAUDE_HOME (default ~/.claude).
Standard library, Python 3.9. The only credentials it handles are the team's MCP tokens, which `edit` writes into the
team repository's mcp.json by the team's decision (see brain/teams/README.md); nothing else is ever written."""
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.environ.get("CLAUDE_HOME") or os.path.expanduser("~/.claude")
BRAIN = os.path.join(HOME, "brain")
TEAMS = os.path.join(BRAIN, "teams")
SOURCES = os.environ.get("PAAS_TEAMS") or ("/opt/paas/teams" if os.path.isdir("/opt/paas/teams")
                                            else os.path.join(BRAIN, "team-sources"))   # multi-user VM, else the installer's copies
STATE = os.path.join(TEAMS, ".installed.json")             # skills / agents the active team put into ~/.claude
NAME = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
LINKS = ("notes.md", "environment.md", "tool-map.md", "notes", "captures", "incidents")   # brain paths -> knowledge/
IDENT = ["-c", "user.name=brain", "-c", "user.email=brain@localhost"]


def die(msg):
    sys.exit("paas-team: " + msg)


def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return default


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def jload(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default if default is not None else {}


def git(repo, *args, timeout=60):
    try:
        r = subprocess.run(["git", "-C", repo] + IDENT + list(args), capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, GIT_TERMINAL_PROMPT="0"))
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:                                   # no git, timeout
        return 124, str(e)


def active():
    t = read(os.path.join(BRAIN, "team")).strip()
    return t if t and NAME.match(t) and os.path.isdir(os.path.join(TEAMS, t)) else ""


def mode():
    """plugin: the team is the Claude Code plugin paas-brain-<team>, the same install as everyone else's (skills, agents,
    hooks and docs-local from the plugin); files: the skills and agents copied into ~/.claude, for a machine without the
    claude command. Written by the installer (team-mode); without it: plugin when claude is in PATH."""
    m = read(os.path.join(BRAIN, "team-mode")).strip()
    if m in ("files", "plugin"):
        return m
    return "plugin" if shutil.which("claude") else "files"


def team_dir(team):
    return os.path.join(TEAMS, team)


def plugin_dir(tdir):
    """the plugin folder named by the repository's marketplace.json (paas-brain-<team>)"""
    mk = jload(os.path.join(tdir, ".claude-plugin", "marketplace.json"))
    for p in mk.get("plugins", []):
        d = os.path.join(tdir, p.get("source", "").lstrip("./"))
        if os.path.isfile(os.path.join(d, "team.json")):
            return d
    for d in glob.glob(os.path.join(tdir, "paas-brain-*")):
        if os.path.isfile(os.path.join(d, "team.json")):
            return d
    return ""


def info(tdir):
    """the team's data: repository team.json over the plugin's"""
    plug = plugin_dir(tdir)
    t = jload(os.path.join(plug, "team.json")) if plug else {}
    t.update({k: v for k, v in jload(os.path.join(tdir, "team.json")).items() if k != "skills" and k != "agents"})
    t["plugin_dir"] = plug
    return t


def bump_version(plug):
    """plugin.json and team.json get the library version plus a fingerprint of the plugin's content (the same rule as
    publish.py): Claude Code hands out a new copy of a plugin from a git-hosted marketplace only when the version string
    changes, so every edit of the plugin folder must change it. Returns the new version."""
    h = hashlib.sha1()
    for root, dirs, files in os.walk(plug):
        dirs.sort()
        for f in sorted(files):
            if f in ("plugin.json", "team.json") or "__pycache__" in root:
                continue
            h.update(os.path.relpath(os.path.join(root, f), plug).encode())
            with open(os.path.join(root, f), "rb") as fh:
                h.update(fh.read())
    ver = ""
    for name in ("team.json", os.path.join(".claude-plugin", "plugin.json")):
        pj = os.path.join(plug, name)
        d = jload(pj)
        d["version"] = str(d.get("version", "0")).split("-")[0] + "-" + h.hexdigest()[:8]
        write(pj, json.dumps(d, indent=2, sort_keys=True) + "\n")
        ver = d["version"]
    return ver


def digest(folder):
    """cheap fingerprint of a plugin folder: paths, sizes, mtimes (no hashing of content)"""
    parts = []
    for root, dirs, files in os.walk(folder):
        dirs.sort()
        for f in sorted(files):
            p = os.path.join(root, f)
            try:
                st = os.stat(p)
            except OSError:
                continue
            parts.append("%s:%d:%d" % (os.path.relpath(p, folder), st.st_size, int(st.st_mtime)))
    return hashlib.sha1("\n".join(parts).encode()).hexdigest()[:16]


def remote_of(tdir):
    rc, out = git(tdir, "remote", "get-url", "origin", timeout=5)
    return out if rc == 0 else ""


def local_teams():
    out = {}
    if os.path.isdir(TEAMS):
        for d in sorted(os.listdir(TEAMS)):
            if NAME.match(d) and plugin_dir(os.path.join(TEAMS, d)):
                out[d] = os.path.join(TEAMS, d)
    return out


def source_teams():
    out = {}
    if os.path.isdir(SOURCES):
        for d in sorted(os.listdir(SOURCES)):
            if NAME.match(d) and plugin_dir(os.path.join(SOURCES, d)):
                out[d] = os.path.join(SOURCES, d)
    return out


def listing():
    act = active()
    teams = []
    seen = set()
    mine = jload(os.path.join(HOME, "paas-market.json")).get("installed", {})
    for name, tdir in local_teams().items():
        t = info(tdir)
        teams.append({"name": name, "title": t.get("title", name), "description": t.get("description", ""),
                      "version": t.get("version", ""), "local": True, "active": name == act,
                      "source": None, "remote": remote_of(tdir) or t.get("remote") or None,
                      "skills": len(t.get("skills", [])), "agents": len(t.get("agents", [])),
                      "mcp": t.get("mcp", []),
                      "mcp_added": sorted(m for m in t.get("mcp", []) if m == "docs-local" or f"mcp/{m}" in mine
                                          or (name == act and m in (installed().get("mcp") or {})))})
        seen.add(name)
    for name, sdir in source_teams().items():
        if name in seen:
            continue
        t = info(sdir)
        teams.append({"name": name, "title": t.get("title", name), "description": t.get("description", ""),
                      "version": t.get("version", ""), "local": False, "active": False,
                      "source": sdir, "remote": t.get("remote") or None,
                      "skills": len(t.get("skills", [])), "agents": len(t.get("agents", [])),
                      "mcp": t.get("mcp", []), "mcp_added": []})
    return {"active": act or None, "mode": mode(), "brain": BRAIN, "teams": teams}


# ---- add -----------------------------------------------------------------------------------------------------

def add(team, source=None, quiet=False):
    if not NAME.match(team or ""):
        die("team name: lower-case letters, digits, - and _")
    dest = team_dir(team)
    if plugin_dir(dest):
        return dest
    if os.path.exists(dest):
        if os.path.isdir(os.path.join(dest, "knowledge")) or os.listdir(dest) and os.path.isdir(os.path.join(dest, ".git")) and \
                git(dest, "rev-parse", "--verify", "-q", "HEAD", timeout=5)[0] == 0:
            die(f"{dest} exists but holds no team plugin; remove it first")
        shutil.rmtree(dest, ignore_errors=True)                    # an interrupted clone: start again
    os.makedirs(TEAMS, exist_ok=True)
    tmp = dest + ".tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    src_dir = os.path.join(SOURCES, team)
    if not source:
        if not plugin_dir(src_dir):
            die(f"no team {team!r}: give its git url or directory (paas-team add {team} <source>)")
        source = info(src_dir).get("remote") or src_dir
    url = source if "://" in source or (":" in source and not os.path.exists(source)) else ""
    if url:
        if not quiet:
            print(f"cloning team {team} from {url} ...")
        rc, out = git(TEAMS, "clone", "-q", url, tmp, timeout=300)
        if rc and plugin_dir(src_dir):                       # the remote is not reachable: the VM's copy, remote kept
            print(f"note: clone from {url} failed ({out.splitlines()[-1][:120] if out else 'no answer'}); using {src_dir}, "
                  "the remote is set for later syncs")
            shutil.rmtree(tmp, ignore_errors=True)
            source, url_later = src_dir, url
        elif rc:
            shutil.rmtree(tmp, ignore_errors=True)
            die(f"clone failed: {out[-300:]}")
        else:
            os.rename(tmp, dest)
            return dest
    else:
        url_later = ""
    source = os.path.abspath(source)
    if not plugin_dir(source):
        die(f"{source} is not a team repository (no paas-brain-<team>/team.json)")
    if os.path.isdir(os.path.join(source, ".git")):
        rc, out = git(TEAMS, "clone", "-q", source, tmp, timeout=120)
        if rc:
            shutil.rmtree(tmp, ignore_errors=True)
            die(f"clone of {source} failed: {out[-300:]}")
        if url_later:
            git(tmp, "remote", "set-url", "origin", url_later, timeout=5)
    else:
        shutil.copytree(source, tmp, ignore=shutil.ignore_patterns("__pycache__", "*.pyc", "._*"))
        git(tmp, "init", "-q", "-b", "main", timeout=10)
        git(tmp, "add", "-A", timeout=30)
        git(tmp, "commit", "-q", "-m", f"team {team}: added", timeout=30)
        if url_later:
            git(tmp, "remote", "add", "origin", url_later, timeout=5)
    os.rename(tmp, dest)
    return dest


# ---- use / refresh ---------------------------------------------------------------------------------------------

def link(brain_name, target, template=None):
    """~/.claude/brain/<name> -> target. A real file or directory there is moved into the team's knowledge the first
    time a team is used (the person's own notes travel with them): a directory merges (files missing on the team side
    move over), a file replaces a team file that is still the untouched template, else its '- ' lines the team file
    lacks are appended; the person's file is kept as <name>.pre-team."""
    p = os.path.join(BRAIN, brain_name)
    if os.path.islink(p):
        if os.readlink(p) == target:
            return
        os.remove(p)
    elif os.path.exists(p):
        if not os.path.exists(target):
            shutil.move(p, target)
        elif os.path.isdir(p) and os.path.isdir(target):     # merge: files missing on the team side move over
            for name in os.listdir(p):
                if not os.path.exists(os.path.join(target, name)):
                    shutil.move(os.path.join(p, name), os.path.join(target, name))
            shutil.rmtree(p)
        elif os.path.isfile(p) and os.path.isfile(target):
            mine, theirs = read(p), read(target)
            if template and theirs.strip() == read(template).strip():
                write(target, mine)                            # the team file was never filled: the person's wins
            else:
                missing = [l for l in mine.splitlines() if l.startswith("- ") and l not in theirs.splitlines()]
                if missing:
                    write(target, theirs.rstrip("\n") + "\n" + "\n".join(missing) + "\n")
            os.replace(p, p + ".pre-team")
        else:
            os.replace(p, p + ".pre-team")
    os.makedirs(os.path.dirname(target), exist_ok=True)
    os.symlink(target, p)


def copy_rule(src, dst):
    if os.path.islink(dst):                                   # multi-user VM: a link to root's shared copy
        os.remove(dst)
    shutil.copy(src, dst)


def installed():
    return jload(STATE, {"skills": [], "agents": [], "mcp": []})


def market_bin():
    return next((p for p in ("/opt/paas/bin/paas-market", os.path.expanduser("~/.local/bin/paas-market"),
                             "/usr/local/bin/paas-market") if os.path.isfile(p)), "")


def market(*args):
    try:
        r = subprocess.run([sys.executable, market_bin()] + list(args), capture_output=True, text=True, timeout=90,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, PAAS_MARKET=os.environ.get("PAAS_MARKET", "/opt/paas/marketplace")))
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 127, str(e)


def mcp_ready(cfg):
    """a server entry of the team's mcp.json with its placeholders filled (HOST, TOKEN) and a command that exists"""
    cmd = cfg.get("command", "")
    if cmd and os.path.isabs(cmd) and not os.path.exists(cmd):
        return False
    return "HOST" not in cfg.get("url", "") and "TOKEN" not in json.dumps(cfg.get("headers", {}))


def claude_mcp(*args):
    try:
        r = subprocess.run(["claude", "mcp"] + list(args), capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 127, str(e)


def apply_mcp(t, old, tdir):
    """The team's live MCP servers for this person. First from the team repository's mcp.json (address and token kept
    there by the team's decision: `claude mcp add-json`, works on a laptop too); a server not filled in there comes from
    the VM's marketplace (root set it up in the Market tab). The previous team's servers leave; a server the person added
    themselves (marketplace state) is never touched. Returns {name: "team" | "market"}."""
    want = [m for m in t.get("mcp", []) if m != "docs-local"]          # docs-local comes with every install
    servers = jload(os.path.join(tdir, "mcp.json"))
    mine = jload(os.path.join(HOME, "paas-market.json")).get("installed", {})
    prev = old.get("mcp", {})
    prev = {m: "market" for m in prev} if isinstance(prev, list) else prev
    for m, via in prev.items():
        if m in want:
            continue
        if via == "team" and shutil.which("claude"):
            claude_mcp("remove", "-s", "user", m)
        elif via == "market" and market_bin() and f"mcp/{m}" in mine:
            market("remove", f"mcp/{m}")
    added = {}
    have_library = os.path.exists(os.path.join(BRAIN, "library", "docs.db"))
    for m in want:
        if m == "docs-search" and have_library:
            continue                                              # docs-local covers it here (library and knowledge)
        if m == "docs-search" and servers.get(m) and "?team=" in servers[m].get("url", ""):
            servers[m] = {**servers[m], "url": servers[m]["url"].split("?team=")[0]}   # docs-local has the knowledge: the VM gives the library
        if f"mcp/{m}" in mine and prev.get(m) != "market":
            continue                                              # the person added it themselves before any team: theirs
        cfg = servers.get(m) or {}
        if cfg and mcp_ready(cfg) and shutil.which("claude"):
            claude_mcp("remove", "-s", "user", m)
            rc, out = claude_mcp("add-json", "-s", "user", m, json.dumps(cfg))
            if rc == 0:
                if prev.get(m) == "market" and market_bin() and f"mcp/{m}" in mine:
                    market("remove", f"mcp/{m}")              # the team's own entry replaces the marketplace one
                added[m] = "team"
                continue
            print(f"note: MCP {m}: claude mcp add-json failed ({out.splitlines()[-1][:120] if out else 'no answer'})")
        if market_bin():
            if prev.get(m) == "market":
                added[m] = "market"
                continue
            rc, out = market("add", f"mcp/{m}")
            if rc == 0:
                added[m] = "market"
            else:
                print(f"note: MCP {m} not added ({out.splitlines()[-1][:120] if out else 'no answer'}); fill it in the team editor or the Market tab")
        elif not cfg:
            print(f"note: MCP {m}: no address in the team's mcp.json yet (team editor)")
    return added


def personal(kind, name):
    """A skill or agent the person made (web UI: .user-skill / agents/.user-agents) or added from the marketplace
    (~/.claude/paas-market.json) is theirs: a team switch never removes or overwrites it."""
    if kind == "skills" and os.path.exists(os.path.join(HOME, "skills", name, ".user-skill")):
        return True
    if kind == "agents" and name in read(os.path.join(HOME, "agents", ".user-agents")).split():
        return True
    return f"{kind[:-1]}/{name}" in jload(os.path.join(HOME, "paas-market.json")).get("installed", {})


def remove_team_files(old):
    """the previous team's skills and agents leave ~/.claude (never a personal one)"""
    for n in old.get("skills", []):
        d = os.path.join(HOME, "skills", n)
        if os.path.isdir(d) and not personal("skills", n):
            shutil.rmtree(d)
    for n in old.get("agents", []):
        f = os.path.join(HOME, "agents", n + ".md")
        if os.path.isfile(f) and not personal("agents", n):
            os.remove(f)


def apply_files(plug, t):
    """files mode: the team's skills / agents replace the previous team's in ~/.claude/{skills,agents}"""
    remove_team_files(installed())
    os.makedirs(os.path.join(HOME, "skills"), exist_ok=True)
    os.makedirs(os.path.join(HOME, "agents"), exist_ok=True)
    put = {"skills": [], "agents": []}
    for n in t.get("skills", []):
        src, dst = os.path.join(plug, "skills", n), os.path.join(HOME, "skills", n)
        if os.path.isdir(src) and not personal("skills", n):     # the person's own or marketplace copy of that name wins
            shutil.rmtree(dst, ignore_errors=True)
            shutil.copytree(src, dst)
            put["skills"].append(n)
    for n in t.get("agents", []):
        src = os.path.join(plug, "agents", n + ".md")
        if os.path.isfile(src) and not personal("agents", n):
            shutil.copy(src, os.path.join(HOME, "agents", n + ".md"))
            put["agents"].append(n)
    put["mcp"] = apply_mcp(t, installed(), os.path.dirname(plug))
    write(STATE, json.dumps(put, indent=2) + "\n")


def claude(*args):
    try:
        r = subprocess.run(["claude", "plugin"] + list(args), capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 127, str(e)


def apply_plugin(team, tdir):
    """plugin mode: this team's plugin installed and enabled from the person's clone (a marketplace added from a local
    path loads in place, so a sync brings new skills to the next session with no update step), every other local team's
    plugin disabled, the pre-team plugin and a user-scope docs-local (the plugin carries its own) removed"""
    if not shutil.which("claude"):
        print("note: claude is not in PATH; the plugin is registered next time (paas-team use " + team + ")")
        return
    name = "paas-brain-" + team
    rc, out = claude("marketplace", "add", tdir)
    if rc:
        claude("marketplace", "update", name)                 # already there (this clone, or the team's GitLab url): fine
    rc, out = claude("list")
    if f"{name}@{name}" in out:
        claude("update", f"{name}@{name}")
        claude("enable", f"{name}@{name}")
    else:
        rc, out = claude("install", f"{name}@{name}", "--scope", "user")
        if rc:
            rc, out = claude("install", f"{name}@{name}")
        if rc:
            print(f"note: plugin not installed: {out[-200:]}\n      run: claude plugin marketplace add {tdir} && claude plugin install {name}@{name}")
    for other in local_teams():
        if other != team:
            o = "paas-brain-" + other
            claude("disable", f"{o}@{o}")
    if "paas-brain@paas-brain" in out:                        # the pre-team laptop plugin
        claude("uninstall", "paas-brain@paas-brain")
    claude_mcp("remove", "-s", "user", "docs-local")           # one docs-local only: the plugin's (same library, plus the knowledge index)
    old = installed()
    if old.get("skills") or old.get("agents"):                 # copies left from files mode leave ~/.claude
        remove_team_files(old)


def apply(team, say=True, skills=True, plugin_cmds=True):
    tdir = team_dir(team)
    plug = plugin_dir(tdir)
    if not plug:
        die(f"team {team} is not added (paas-team add {team} [<source>])")
    t = info(tdir)
    k = os.path.join(tdir, "knowledge")
    for d in ("notes", "captures", "incidents"):
        os.makedirs(os.path.join(k, d), exist_ok=True)
    first = not read(os.path.join(BRAIN, "team")).strip()     # first team ever: the person's files move in
    os.makedirs(BRAIN, exist_ok=True)
    for name in LINKS:
        link(name, os.path.join(k, name), os.path.join(plug, "brain", name) if name.endswith(".md") else None)
    for name in ("notes.md", "environment.md", "tool-map.md"):    # the team's memory files start from the templates
        if not os.path.exists(os.path.join(k, name)):
            shutil.copy(os.path.join(plug, "brain", name), os.path.join(k, name))
    copy_rule(os.path.join(plug, "brain", "persona.md"), os.path.join(BRAIN, "persona.md"))
    copy_rule(os.path.join(plug, "brain", "storage.md"), os.path.join(BRAIN, "storage.md"))
    if not os.path.exists(os.path.join(BRAIN, "coding.md")):
        shutil.copy(os.path.join(plug, "brain", "coding.md"), os.path.join(BRAIN, "coding.md"))
    if not skills:
        pass                                                  # bootstrap from inside the plugin: it already provides them
    elif mode() == "plugin":
        if plugin_cmds:                                       # a refresh after a sync needs none: the plugin loads in place
            apply_plugin(team, tdir)
    else:
        apply_files(plug, t)
    if mode() == "plugin" or not skills:                      # files mode records the servers inside apply_files
        st = installed()
        write(STATE, json.dumps({"skills": [], "agents": [], "mcp": apply_mcp(t, st, tdir)}, indent=2) + "\n")
    write(os.path.join(BRAIN, "team"), team + "\n")
    write(os.path.join(TEAMS, ".applied"), json.dumps({"team": team, "digest": digest(plug), "version": t.get("version", "")}) + "\n")
    chats = os.path.expanduser("~/chats/CLAUDE.md")          # regenerated by the session-start hook from the new rules
    if os.path.exists(chats) and read(chats)[:40].startswith("<!-- generated by the brain"):
        os.utime(os.path.join(BRAIN, "storage.md"), None)
    ignore = os.path.join(BRAIN, ".gitignore")                # the old whole-brain history never tracks the team clones
    if os.path.isdir(os.path.join(BRAIN, ".git")):
        lines = read(ignore).splitlines()
        for l in ("teams/", "team-sources/", "team", "team-mode", "persona.md"):
            if l not in lines:
                lines.append(l)
        write(ignore, "\n".join(lines) + "\n")
    if say:
        mcp = list(installed().get("mcp") or [])
        print(f"team {team} ({t.get('title', team)}) active, {mode()} mode: {len(t.get('skills', []))} skills, "
              f"{len(t.get('agents', []))} agents" + (f", MCP {', '.join(mcp)}" if mcp else "")
              + f", version {t.get('version', '?')}; knowledge in {k}" + (" (your notes moved into it)" if first else ""))
        print("Start a new Claude session (or a new chat in the web UI) to work with it.")
    return t


def use(team, source=None):
    add(team, source)
    apply(team)


def bootstrap(team, source):
    """Called by the plugin's own session-start hook on a bare `claude plugin install`: the team's knowledge clone, the
    links, persona / rules, the core rules as ~/.claude/brain/main.md with one import line in the person's CLAUDE.md,
    and this tool in ~/.claude/tools. No `claude plugin` command (the plugin is installed and enabled already)."""
    add(team, source, quiet=True)
    write(os.path.join(BRAIN, "team-mode"), "plugin\n")
    t = apply(team, say=False, skills=False)
    plug = plugin_dir(team_dir(team))
    shutil.copy(os.path.join(plug, "brain", "CLAUDE.md"), os.path.join(BRAIN, "main.md"))
    md = os.path.join(HOME, "CLAUDE.md")
    if "@~/.claude/brain/main.md" not in read(md).split():
        with open(md, "a", encoding="utf-8") as f:
            f.write("\n@~/.claude/brain/main.md\n")
    tools = os.path.join(HOME, "tools")
    os.makedirs(tools, exist_ok=True)
    shutil.copy(os.path.abspath(__file__), os.path.join(tools, "paas-team"))
    os.chmod(os.path.join(tools, "paas-team"), 0o755)
    print(f"team {team} ({t.get('title', team)}) set up from the plugin: knowledge in {os.path.join(team_dir(team), 'knowledge')}, "
          f"rules imported from ~/.claude/brain/main.md; tool: ~/.claude/tools/paas-team")


def refresh():
    t = active()
    if not t:
        die("no active team (paas-team use <team>)")
    apply(t, say=False, plugin_cmds=False)
    print(f"team {t}: files re-applied")


def needs_refresh():
    """True when the active team's plugin changed since it was applied (after a sync pulled a new one)"""
    t = active()
    if not t:
        return False
    plug = plugin_dir(team_dir(t))
    st = jload(os.path.join(TEAMS, ".applied"))
    return bool(plug) and (st.get("team") != t or st.get("digest") != digest(plug))


def sync():
    t = active()
    if not t:
        print("brain: no active team")
        return 0
    nc = next((p for p in (os.path.join(HOME, "hooks", "notes-check.py"), "/opt/paas/hooks/notes-check.py",
                           os.path.join(plugin_dir(team_dir(t)), "hooks", "notes-check.py")) if os.path.isfile(p)), "")
    if nc:
        try:
            r = subprocess.run([sys.executable, nc, "--sync"], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
            print(r.stdout.strip() or r.stderr.strip()[-200:])
            rc = r.returncode
        except subprocess.TimeoutExpired:
            print("brain: sync still running after 60 s (remote not answering?); try again later")
            rc = 1
    else:
        rc, out = git(team_dir(t), "pull", "--rebase", "--autostash", "-q", timeout=60)
        print("brain: in sync" if rc == 0 else out[-200:])
    if needs_refresh():
        apply(t, say=False, plugin_cmds=False)
        print(f"team {t}: updated to version {info(team_dir(t)).get('version', '?')} (new session needed)")
    return 1 if rc else 0


def set_remote(team, url):
    tdir = team_dir(team)
    if not plugin_dir(tdir):
        die(f"team {team} is not added")
    rc, _ = git(tdir, "remote", "get-url", "origin", timeout=5)
    git(tdir, "remote", "set-url" if rc == 0 else "add", "origin", url, timeout=5)
    print(f"team {team}: remote {url} (first sync: paas-team sync)")


def off():
    t = active()
    if not t:
        print("no active team")
        return
    k = os.path.join(team_dir(t), "knowledge")
    for name in LINKS:
        p = os.path.join(BRAIN, name)
        if os.path.islink(p):
            os.remove(p)
            src = os.path.join(k, name)
            if os.path.isdir(src):
                shutil.copytree(src, p)
            elif os.path.isfile(src):
                shutil.copy(src, p)
    if mode() == "plugin":
        if shutil.which("claude"):
            claude("disable", f"paas-brain-{t}@paas-brain-{t}")
    else:
        old = installed()
        remove_team_files(old)
        apply_mcp({"mcp": []}, old, team_dir(t))
        write(STATE, json.dumps({"skills": [], "agents": [], "mcp": {}}) + "\n")
    os.remove(os.path.join(BRAIN, "team"))
    print(f"no team: {t}'s skills, agents and MCP servers left ~/.claude (your own and marketplace ones stay); persona.md, storage.md and the "
          f"knowledge files are plain copies in {BRAIN} now, yours to edit; the team clone stays in {team_dir(t)}.\n"
          "Add skills from the marketplace (paas-market add skill/<name>, or the Market tab); paas-team use <team> joins a team again.")


def export(team=None, dest=None):
    """a zip a laptop unpacks: the plugin folder, the marketplace file, install-team.sh and the team's README"""
    import zipfile
    team = team or active()
    if not team:
        die("which team? paas-team export <team>")
    tdir = team_dir(team) if plugin_dir(team_dir(team)) else os.path.join(SOURCES, team)
    plug = plugin_dir(tdir)
    if not plug:
        die(f"team {team} is not added and no source offers it")
    t = info(tdir)
    dest = dest or os.path.expanduser("~/storage-reports")
    os.makedirs(dest, exist_ok=True)
    out = os.path.join(dest, f"paas-brain-{team}-{t.get('version', 'x')}.zip")
    skip = ("__pycache__", ".pyc", "._", ".DS_Store")
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        for sub in (os.path.basename(plug), ".claude-plugin", "bin"):
            for root, _, files in os.walk(os.path.join(tdir, sub)):
                for f in files:
                    full = os.path.join(root, f)
                    if any(x in full for x in skip):
                        continue
                    z.write(full, os.path.join(f"paas-brain-{team}", os.path.relpath(full, tdir)))
        for f in ("README.md", "install-team.sh", "team.json"):
            if os.path.isfile(os.path.join(tdir, f)):
                z.write(os.path.join(tdir, f), os.path.join(f"paas-brain-{team}", f))
    print(f"{out}\nOn the laptop: unzip it, then  sh paas-brain-{team}/install-team.sh  (Claude Code installed; the docs library is not in the zip)")
    return out



#!/bin/sh
# Add your own documents to the offline docs library (searched by docs-local like everything else):
#   put PDF / HTML / Markdown / text files in ~/.claude/brain/inbox/<vendor>/<product>/   (loose files: local/inbox)
#   then run:  add-docs
#   add-docs --brain   index ~/.claude/brain/notes/*.md and incidents/**/*.md (local/brain-notes, local/brain-incidents) into
#                      ~/.claude/brain/brain.db ($BRAIN_DB), the person's own small index that docs-local searches with the
#                      library (the shared library is read-only on the multi-user VM; the session-start hook runs this)
# Or fetch pages the VM can reach (intranet wiki, internal portal, vendor page through the proxy) straight in:
#   add-docs https://wiki.corp/san/zoning-standard [more urls] [--to <vendor>/<product>]   (default: web/<host>)
# The url becomes the document's link in search results. Only new or changed files are read; a file deleted from
# the inbox leaves the library. The library's own documents are never touched, and install.sh runs this again
# after a library update, so your documents stay.
set -eu
ME=$0; while [ -L "$ME" ]; do ME=$(readlink "$ME"); done; TOOLS=$(cd "$(dirname "$ME")" && pwd -P)   # readlink -f is not on every macOS
INBOX=${INBOX:-$HOME/.claude/brain/inbox}
DB=${DOCS_DB:-$HOME/.claude/brain/library/docs.db}
[ "${1:-}" = "--brain" ] || [ -f "$DB" ] || { echo "add-docs: no $DB (install the documentation library first)"; exit 1; }
PY=$HOME/.claude/devtools-venv/bin/python
"$PY" -c "import pypdf" 2>/dev/null || PY=python3          # PDFs need pypdf (installed by install.sh in the devtools venv)
mkdir -p "$INBOX"
if [ "${1:-}" = "--brain" ]; then
  # copies (mtime kept, so unchanged pages are not re-read) in a staging tree shaped local/<product>/<file>; rebuilt
  # each run, so a page removed from notes/ leaves the index. captures, notes.md and environment.md stay out.
  B=${BRAIN:-$HOME/.claude/brain}; S=$B/.brain-index
  rm -rf "$S"; mkdir -p "$S/local/brain-notes" "$S/local/brain-incidents"
  for f in "$B"/notes/*.md; do [ -f "$f" ] && cp -p "$f" "$S/local/brain-notes/"; done
  find "$B/incidents" -name '*.md' -type f 2>/dev/null | while read -r f; do
    cp -p "$f" "$S/local/brain-incidents/$(basename "$(dirname "$f")")-$(basename "$f")"
  done
  BDB=${BRAIN_DB:-${CLAUDE_HOME:-$HOME/.claude}/brain/brain.db}
  exec "$PY" "$TOOLS/docs_index.py" --docs "$S" --db "$BDB" --add brain/
fi
if [ $# -gt 0 ]; then
  python3 - "$INBOX" "$@" <<'EOF'
import json, os, re, sys, urllib.parse, urllib.request
inbox, args = sys.argv[1], sys.argv[2:]
to = None
if "--to" in args:
    i = args.index("--to")
    to = args[i + 1].strip("/") if i + 1 < len(args) else sys.exit("add-docs: --to <vendor>/<product>")
    del args[i:i + 2]
    if to.count("/") != 1 or ".." in to:
        sys.exit("add-docs: --to needs <vendor>/<product>, e.g. --to cisco/mds")
EXT = {"application/pdf": ".pdf", "text/html": ".html", "text/markdown": ".md", "text/plain": ".txt"}
for url in args:
    if not url.startswith(("http://", "https://")):
        sys.exit(f"add-docs: not a url: {url}")
    u = urllib.parse.urlparse(url)
    d = os.path.join(inbox, *(to or f"web/{u.hostname}").split("/"))
    os.makedirs(d, exist_ok=True)
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "add-docs"}), timeout=60) as r:
            body, ctype = r.read(), r.headers.get_content_type()
    except Exception as e:
        print(f"add-docs: {url}: {e}")
        continue
    ext = EXT.get(ctype) or (".pdf" if body[:5] == b"%PDF-" else None)
    if not ext:
        print(f"add-docs: {url}: {ctype} is not a document (pdf / html / markdown / text), skipped")
        continue
    name = re.sub(r"[^\w.-]+", "-", (u.path.strip("/") or u.hostname) + (f"-{u.query}" if u.query else ""))[-120:]
    name = os.path.splitext(name)[0].strip("-.") + ext
    open(os.path.join(d, name), "wb").write(body)
    mf = os.path.join(d, "manifest.json")
    man = json.load(open(mf)) if os.path.exists(mf) else {}
    man[name] = {"url": url}
    json.dump(man, open(mf, "w"), indent=1)
    print(f"fetched {url} -> {os.path.join(d, name)} ({len(body) // 1024} KB)")
EOF
fi
find "$INBOX" -name '._*' -type f -delete 2>/dev/null || true
"$PY" "$TOOLS/docs_index.py" --docs "$INBOX" --db "$DB" --add inbox/

#!/bin/sh
# MCP server of the code-graph plugin: code-review-graph for the git repository Claude runs in.
# Outside a git repository: an empty server (no tools), so storage chats pay nothing. The first time on a machine
# without an environment: an empty server that says so, while the environment builds in the background (a minute).
BIN=$(cd "$(dirname "$0")" && pwd)
DIR=${CLAUDE_PROJECT_DIR:-$PWD}
ROOT=$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null)
PYTHON=$(command -v python3 || command -v python)
[ -n "$ROOT" ] || exec "$PYTHON" "$BIN/empty_mcp.py"
ENV=$("$BIN/crg-env") || { (nohup "$BIN/crg-env" --build >/dev/null 2>&1 &); exec "$PYTHON" "$BIN/empty_mcp.py" preparing; }
# the tools a smaller model uses well; the rest (wiki, embeddings, refactor that edits files) stay off
TOOLS=${CRG_TOOLS:-build_or_update_graph_tool,list_graph_stats_tool,get_minimal_context_tool,get_impact_radius_tool,query_graph_tool,get_review_context_tool,semantic_search_nodes_tool,detect_changes_tool,find_large_functions_tool,get_architecture_overview_tool,list_flows_tool,get_flow_tool,get_affected_flows_tool,traverse_graph_tool}
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 DO_NOT_TRACK=1
exec "$ENV/bin/code-review-graph" serve --repo "$ROOT" --tools "$TOOLS"

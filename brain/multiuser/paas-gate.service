[Unit]
Description=Peleg As A Service sign-in gate (https; port and idle stop in /etc/paas/gate.env)
After=network-online.target
Wants=network-online.target

[Service]
# GATE_PORT (default 3001) and GATE_IDLE_MINUTES (default 60; 0 = never stop an idle UI) live in /etc/paas/gate.env, which
# the installers never overwrite
EnvironmentFile=-/etc/paas/gate.env
ExecStart=/opt/paas/ui/node/bin/node /opt/paas/gate/gate.js
Restart=on-failure
RestartSec=2
PrivateTmp=yes
ProtectHome=no
MemoryMax=256M
ProtectKernelTunables=yes
ProtectKernelModules=yes
LimitNOFILE=8192
TasksMax=2048

[Install]
WantedBy=multi-user.target

#!/bin/sh
# git credential helper for every account on the multi-user VM (added to each account's git config by `paas-user provision`,
# and to the docs service): the GitLab tokens root stored with `paas-user git-token` live in /etc/paas/git as
# "username:token": <host>.token for a whole host (a group token), or <host>__<group>__<project>.git.token for one
# repository (a project token; git hands the path over when credential.useHttpPath is on for the host, which paas-user
# sets). git asks with "get" and key=value lines on stdin; this answers username and password from the repository's file,
# else the host's, nothing otherwise (git then tries the next helper or fails without a prompt). "store" and "erase" do
# nothing: the tokens are root's. A person's own helper, listed first, wins over this one.
[ "${1:-}" = get ] || exit 0
host=; path=
while IFS= read -r line; do
  case $line in host=*) host=${line#host=} ;; path=*) path=${line#path=} ;; esac
done
host=$(printf '%s' "$host" | tr 'A-Z' 'a-z')
case $host in ''|*[!a-z0-9.:_-]*) exit 0 ;; esac                # a host name (with port) only: never a path
case $path in *[!A-Za-z0-9./_-]*|*..*) path= ;; esac            # a repository path only
D=${PAAS_GIT_DIR:-/etc/paas/git}
f=""
if [ -n "$path" ]; then p="$D/${host}__$(printf '%s' "$path" | tr '/' '_' | sed 's/_/__/g').token"; [ -r "$p" ] && f=$p; fi
[ -n "$f" ] || f="$D/$host.token"
[ -r "$f" ] || exit 0
IFS= read -r tok < "$f" || exit 0
case $tok in
  '') exit 0 ;;
  *:*) printf 'username=%s\npassword=%s\n' "${tok%%:*}" "${tok#*:}" ;;
  *) printf 'username=paas\npassword=%s\n' "$tok" ;;
esac

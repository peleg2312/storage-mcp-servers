#!/bin/sh
# git credential helper for every account on the multi-user VM (added to each account's git config by `paas-user provision`,
# and to the docs service): the team's GitLab token root stored with `paas-user git-token <host>` lives in
# /etc/paas/git/<host>.token as "username:token". git asks with "get" and key=value lines on stdin; this answers username
# and password for a host that has a token file, nothing otherwise (git then tries the next helper or fails without a
# prompt). "store" and "erase" do nothing: the token is root's. A person's own helper, listed first, wins over this one.
[ "${1:-}" = get ] || exit 0
host=
while IFS= read -r line; do
  case $line in host=*) host=${line#host=} ;; esac
done
host=$(printf '%s' "$host" | tr 'A-Z' 'a-z')
case $host in ''|*[!a-z0-9.:_-]*) exit 0 ;; esac                # a host name (with port) only: never a path
f="${PAAS_GIT_DIR:-/etc/paas/git}/$host.token"
[ -r "$f" ] || exit 0
IFS= read -r tok < "$f" || exit 0
case $tok in
  '') exit 0 ;;
  *:*) printf 'username=%s\npassword=%s\n' "${tok%%:*}" "${tok#*:}" ;;
  *) printf 'username=paas\npassword=%s\n' "$tok" ;;
esac

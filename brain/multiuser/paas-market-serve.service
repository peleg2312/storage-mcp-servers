[Unit]
Description=Marketplace for other VMs (read-only HTTPS, token)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/paas/bin/paas-market-serve
User=paas-market
Group=paas-market
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=512M
TasksMax=64
Restart=on-failure

[Install]
WantedBy=multi-user.target

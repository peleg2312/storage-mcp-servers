# ---- MCP access token(s) - clients send "Authorization: Bearer <token>" ----
# generate with: openssl rand -hex 32   (comma-separate several to rotate)
MCP_AUTH_TOKENS=replace-with-output-of-openssl-rand-hex-32

# ---- UCS Central instances: add _3_, _4_ ... for more ----
UCSC_1_NAME=ucsc-dc1
UCSC_1_HOST=ucs-central-dc1.example.local
UCSC_1_USERNAME=mcp-ro
UCSC_1_PASSWORD=changeme
# optional: UCSC_1_PORT=443

UCSC_2_NAME=ucsc-dc2
UCSC_2_HOST=ucs-central-dc2.example.local
UCSC_2_USERNAME=mcp-ro
UCSC_2_PASSWORD=changeme

LOG_LEVEL=INFO

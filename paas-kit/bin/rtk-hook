#!/usr/bin/env python3
"""Called by rtk-pre only when a Bash command mentions rtk (rare). Refuses a command the model wrote as `rtk ...`
itself: rtk runs the command it is given, and the brain's read-only guard does not look inside `rtk oc delete ...`,
so a write would pass unseen. rtk's own rewrites are not affected (the guard sees the model's plain command; rtk's
hook makes it `rtk ...` after that). rtk recall / gain (reading back what rtk cut, the savings) stay allowed.
Prints a deny decision, or nothing. Python 3.6+."""
import json
import re
import sys

RTK_CMD = re.compile(r"(^|[;&|(`\n]\s*|\$\(\s*|\b(sudo|env|exec|command|xargs|nohup|timeout\s+\S+|sh\s+-c|bash\s+-c)\s+['\"]?)"
                     r"(\S*/)?rtk(\s|$)")
RTK_OK = re.compile(r"^\s*(\S*/)?rtk\s+(gain|recall|--version|--help)\b[^;&|`$\n]*$")

try:
    ev = json.load(sys.stdin)
    cmd = (ev.get("tool_input") or {}).get("command") or ""
    if RTK_CMD.search(cmd) and not RTK_OK.match(cmd):
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse", "permissionDecision": "deny",
            "permissionDecisionReason": "Do not call rtk yourself: commands are shortened for you automatically. "
                                        "Run the plain command (rtk recall <hash> and rtk gain are fine)."}}))
except Exception:
    pass

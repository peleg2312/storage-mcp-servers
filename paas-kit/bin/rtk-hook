#!/usr/bin/env python3
"""rtk plugin hooks (paas-kit). The command Claude runs is never changed: the brain's guard and the permission rules
see exactly what runs. Only the output the model reads afterwards is made shorter.

  rtk-hook post   PostToolUse (Bash): long output of tests, linters, grep / find, git log / diff / status and logs goes
                  through `rtk pipe -f <filter>` (failures, errors and changed lines kept; passing noise dropped).
                  The model can always get the full output: the same command with `| cat` at the end is not filtered.
  rtk-hook pre    PreToolUse (Bash): a command the model writes as `rtk ...` is refused (rtk runs commands itself, which
                  would hide the real command from the guard); the model runs the plain command instead.
Any error: the output stays as it was. Python 3.6+.
"""
import json
import os
import re
import shlex
import subprocess
import sys

RTK = "/opt/paas-kit/bin/rtk"
MIN_CHARS = 1500           # shorter output is left alone
LOG_MIN_LINES = 200        # logs: only long ones
NOTE = "\n[rtk: shortened from {a} to {b} lines (failures, errors and changes kept). Full output: the same command with | cat at the end]"


def words(seg):
    try:
        w = shlex.split(seg)
    except ValueError:
        w = seg.split()
    while w and (re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w[0]) or w[0] in ("sudo", "time", "nice", "command", "exec")):
        w = w[1:]
    if w and w[0] == "timeout":
        w = w[1:]
        while w and (w[0].startswith("-") or re.match(r"^\d+[smhd]?$", w[0])):
            w = w[1:]
    if w:
        w[0] = os.path.basename(w[0])
    if len(w) > 2 and re.match(r"^python[0-9.]*$", w[0]) and w[1] == "-m":
        w = w[2:]
    for i in (1, 2):                                    # npx / uv run / poetry run <tool>
        if w and w[0] in ("npx", "pnpx", "bunx", "uvx") and len(w) > 1:
            w = w[1:]
        if len(w) > 2 and w[0] in ("uv", "poetry", "pipenv", "hatch", "pdm") and w[1] == "run":
            w = w[2:]
    return w


def pick(cmd):
    """the rtk filter for the command whose output Claude sees (the last stage of a pipeline), or None"""
    if re.search(r"\|\s*(cat|tee)\b[^|]*$", cmd) or "<<" in cmd:
        return None                                     # asked for the full output / a here-doc
    last = re.split(r"\|\||&&|;|\|", cmd)[-1].strip()
    w = words(last)
    if not w:
        return None
    c, a = w[0], (w[1] if len(w) > 1 else "")
    if c in ("pytest", "py.test"):
        return "pytest"
    if c == "go":
        return {"test": "go-test", "build": "go-build", "vet": "go-build"}.get(a)
    if c == "cargo" and a in ("test", "nextest"):
        return "cargo-test"
    if c in ("ctest", "vitest", "tsc", "mypy", "prettier", "phpunit", "phpstan"):
        return c
    if c == "ruff":
        return {"check": "ruff-check", "format": "ruff-format"}.get(a, "ruff-check" if a not in ("--version", "help") else None)
    if c in ("grep", "egrep", "fgrep"):
        return "grep"
    if c in ("rg", "find", "fd"):
        return c
    if c == "git":
        sub = next((x for x in w[1:] if not x.startswith("-") and "=" not in x), "")
        return {"log": "git-log", "diff": "git-diff", "show": "git-diff", "status": "git-status"}.get(sub)
    if c in ("journalctl", "dmesg", "tail") or (c in ("oc", "kubectl") and a == "logs"):
        return "log"
    return None


def post(ev):
    if ev.get("tool_name") != "Bash":
        return
    cmd = (ev.get("tool_input") or {}).get("command") or ""
    resp = ev.get("tool_response")
    if not isinstance(resp, dict) or not isinstance(resp.get("stdout"), str):
        return
    out = resp["stdout"]
    f = pick(cmd)
    if not f or len(out) < MIN_CHARS or (f == "log" and out.count("\n") < LOG_MIN_LINES):
        return
    env = dict(os.environ, RTK_TELEMETRY="0", DO_NOT_TRACK="1", NO_COLOR="1")
    r = subprocess.run([RTK, "pipe", "-f", f], input=out, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                       universal_newlines=True, timeout=20, env=env)
    new = (r.stdout or "").rstrip("\n")
    if r.returncode != 0 or not new.strip() or len(new) > 0.8 * len(out):
        return
    a, b = out.count("\n") + 1, new.count("\n") + 1
    upd = dict(resp, stdout=new + NOTE.format(a=a, b=b))
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "updatedToolOutput": upd}}))


RTK_CMD = re.compile(r"(^|[;&|(`]\s*|\$\(\s*|\b(sudo|env|exec|command|xargs|timeout\s+\S+)\s+)(\S*/)?rtk(\s|$)")


def pre(ev):
    if ev.get("tool_name") != "Bash":
        return
    cmd = (ev.get("tool_input") or {}).get("command") or ""
    if RTK_CMD.search(cmd) and not re.match(r"^\s*(\S*/)?rtk\s+(gain|--version|--help)\b", cmd):
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse", "permissionDecision": "deny",
            "permissionDecisionReason": "Do not call rtk: output is shortened for you after each command. "
                                        "Run the plain command (without rtk)."}}))


def main():
    try:
        ev = json.load(sys.stdin)
        (post if sys.argv[1:] == ["post"] else pre)(ev)
    except Exception:
        pass                                            # never break a command because of the filter
    sys.exit(0)


if __name__ == "__main__":
    main()
